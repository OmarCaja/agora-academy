---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import PropertyBox from "../../components/PropertyBox.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import TopicPager from "../../components/TopicPager.astro";
import { slugify } from "../../utils/slugify";

export async function getStaticPaths() {
    const topics = await getCollection("topics");
    return topics.map((entry) => ({
        params: { slug: entry.id },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { title, description, sections, menuGroup } = entry.data;

const GROUP_ORDER = [
    "Aritmética",
    "Álgebra",
    "Funciones y Límites",
    "Potencias, raíces y logaritmos",
    "Estadística y Probabilidad",
];

const allTopics = await getCollection("topics");

allTopics.sort((a, b) => {
    const groupIndexA = GROUP_ORDER.indexOf(a.data.menuGroup || "");
    const groupIndexB = GROUP_ORDER.indexOf(b.data.menuGroup || "");
    if (groupIndexA !== groupIndexB) {
        if (groupIndexA === -1) return 1;
        if (groupIndexB === -1) return -1;
        return groupIndexA - groupIndexB;
    }
    const orderA = a.data.menuOrder ?? 999;
    const orderB = b.data.menuOrder ?? 999;
    if (orderA !== orderB) return orderA - orderB;
    return a.data.title.localeCompare(b.data.title, "es");
});

const currentIndex = allTopics.findIndex((t) => t.id === entry.id);
const prevEntry = currentIndex > 0 ? allTopics[currentIndex - 1] : undefined;
const nextEntry = currentIndex < allTopics.length - 1 ? allTopics[currentIndex + 1] : undefined;

const prevTopic = prevEntry
    ? { title: prevEntry.data.title, slug: `theory/${prevEntry.id}`, group: prevEntry.data.menuGroup }
    : undefined;
const nextTopic = nextEntry
    ? { title: nextEntry.data.title, slug: `theory/${nextEntry.id}`, group: nextEntry.data.menuGroup }
    : undefined;

// Calculate metadata stats
let totalItems = 0;
let totalFormulas = 0;
let totalWords = (description || "").split(/\s+/).filter(Boolean).length;

for (const sec of sections) {
    totalWords += (sec.title || "").split(/\s+/).filter(Boolean).length;
    for (const item of sec.items) {
        totalItems++;
        if (item.formula) totalFormulas++;
        if (item.description) {
            totalWords += item.description.replace(/<[^>]*>/g, " ").split(/\s+/).filter(Boolean).length;
        }
        if (item.example) {
            totalWords += item.example.replace(/<[^>]*>/g, " ").split(/\s+/).filter(Boolean).length;
        }
    }
}

const estimatedReadTime = Math.max(1, Math.ceil(totalWords / 150));

// Detailed Course/LearningResource Schema
const topicSchema = {
    "@context": "https://schema.org",
    "@type": "LearningResource",
    name: title,
    description: description,
    learningResourceType: "Tutorial",
    educationalLevel: ["ESO", "Bachillerato"],
    inLanguage: "es",
    author: {
        "@type": "Organization",
        name: "Academia Ágora",
    },
    hasPart: sections.map((section) => ({
        "@type": "LearningResource",
        name: section.title,
        learningResourceType: "Section",
    })),
};
---

<BaseLayout
    title={`${title} - Ágora`}
    description={description ||
        `Aprende sobre ${title} en Academia Ágora de Matemáticas.`}
    currentPage={`theory/${entry.id}`}
    schema={topicSchema}
    showProgressBar={true}
>
    <div class="content-section">
        <Breadcrumbs
            items={[
                { label: "Inicio", href: "/" },
                { label: "Teoría" },
                ...(menuGroup ? [{ label: menuGroup }] : []),
                { label: title },
            ]}
        />

        <Header title={title.toUpperCase()} />

        <div class="topic-meta">
            <span class="meta-pill">⏱️ ~{estimatedReadTime} min de lectura</span>
            <span class="meta-pill">📑 {sections.length} {sections.length === 1 ? "sección" : "secciones"}</span>
            {totalFormulas > 0 && (
                <span class="meta-pill">📐 {totalFormulas} {totalFormulas === 1 ? "fórmula" : "fórmulas"}</span>
            )}
        </div>

        <div class="search-container">
            <div class="search-input-wrapper">
                <svg
                    class="search-icon"
                    xmlns="http://www.w3.org/2000/svg"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                >
                    <circle cx="11" cy="11" r="8"></circle>
                    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <input
                    type="search"
                    id="theorySearch"
                    placeholder="Buscar en este tema..."
                    aria-label="Buscar en este tema (pulsa / para enfocar)"
                    autocomplete="off"
                />
                <kbd class="search-kbd" id="theorySearchKbd" aria-hidden="true">/</kbd>
                <button
                    type="button"
                    id="clearTheorySearch"
                    class="clear-btn"
                    aria-label="Limpiar búsqueda"
                    style="display: none;"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        class="clear-icon"
                    >
                        <line x1="18" y1="6" x2="6" y2="18"></line>
                        <line x1="6" y1="6" x2="18" y2="18"></line>
                    </svg>
                </button>
            </div>
            <p id="theorySearchCount" class="search-count" aria-live="polite"></p>
        </div>

        <div id="tocWrapper">
            <TableOfContents sections={sections} />
        </div>

        <div id="theoryContent">
            {
                sections.map((section) => (
                    <section
                        id={slugify(section.title)}
                        class="theory-section fade-in"
                        data-theory-section
                        data-section-title={section.title}
                    >
                        <h2>{section.title}</h2>
                        <div class="properties-container">
                            {section.items.map((item) => (
                                <div
                                    class="property-item"
                                    data-theory-item
                                    data-item-title={item.title}
                                    data-item-description={item.description || ""}
                                    data-item-example={item.example || ""}
                                    data-item-formula={item.formula || ""}
                                >
                                    <PropertyBox
                                        title={item.title}
                                        formula={item.formula}
                                        example={item.example}
                                        description={item.description}
                                    />
                                </div>
                            ))}
                        </div>
                    </section>
                ))
            }
        </div>

        <div id="noTheoryResults" class="no-results" style="display: none;">
            <p>No se han encontrado contenidos que coincidan con la búsqueda.</p>
        </div>

        <TopicPager prev={prevTopic} next={nextTopic} />
    </div>
</BaseLayout>

<script>
    import { normalizeText } from "../../utils/normalizeText";

    function initTheoryFilter() {
        const input = document.getElementById("theorySearch") as HTMLInputElement | null;
        const clearBtn = document.getElementById("clearTheorySearch") as HTMLButtonElement | null;
        const kbdBadge = document.getElementById("theorySearchKbd");
        const sections = document.querySelectorAll<HTMLElement>("[data-theory-section]");
        const tocWrapper = document.getElementById("tocWrapper");
        const noResults = document.getElementById("noTheoryResults");
        const searchCount = document.getElementById("theorySearchCount");

        if (!input) return;

        function updateKbdVisibility() {
            if (!kbdBadge || !input) return;
            const isFocused = document.activeElement === input;
            const hasValue = input.value.trim().length > 0;
            kbdBadge.style.display = isFocused || hasValue ? "none" : "inline-flex";
        }

        function updateSearch() {
            if (!input) return;
            const rawValue = input.value.trim();
            const query = normalizeText(rawValue);
            let totalMatches = 0;
            let visibleSections = 0;

            if (clearBtn) {
                clearBtn.style.display = rawValue.length > 0 ? "flex" : "none";
            }
            updateKbdVisibility();

            sections.forEach((section) => {
                const sectionTitle = normalizeText(section.dataset.sectionTitle || "");
                const items = section.querySelectorAll<HTMLElement>("[data-theory-item]");
                let sectionMatches = 0;

                items.forEach((item) => {
                    const title = normalizeText(item.dataset.itemTitle || "");
                    const desc = normalizeText(item.dataset.itemDescription || "");
                    const ex = normalizeText(item.dataset.itemExample || "");
                    const formula = normalizeText(item.dataset.itemFormula || "");
                    const textContent = normalizeText(item.textContent || "");

                    const matches =
                        query === "" ||
                        title.includes(query) ||
                        desc.includes(query) ||
                        ex.includes(query) ||
                        formula.includes(query) ||
                        textContent.includes(query) ||
                        sectionTitle.includes(query);

                    item.style.display = matches ? "" : "none";
                    if (matches) {
                        sectionMatches++;
                        totalMatches++;
                    }
                });

                if (sectionMatches > 0) {
                    section.style.display = "";
                    visibleSections++;
                } else {
                    section.style.display = "none";
                }
            });

            if (tocWrapper) {
                tocWrapper.style.display = query ? "none" : "";
            }

            if (noResults) {
                noResults.style.display = visibleSections === 0 ? "block" : "none";
            }

            if (searchCount) {
                if (query) {
                    searchCount.textContent = `${totalMatches} ${totalMatches === 1 ? "resultado encontrado" : "resultados encontrados"}`;
                } else {
                    searchCount.textContent = "";
                }
            }
        }

        input.addEventListener("input", updateSearch);
        input.addEventListener("focus", updateKbdVisibility);
        input.addEventListener("blur", updateKbdVisibility);

        if (clearBtn) {
            clearBtn.addEventListener("click", () => {
                input.value = "";
                updateSearch();
                input.focus();
            });
        }

        // Global keyboard shortcut ('/' or Cmd/Ctrl + K to focus search)
        function handleKeydown(e: KeyboardEvent) {
            const target = e.target as HTMLElement | null;
            const isTyping = target && (target.tagName === "INPUT" || target.tagName === "TEXTAREA" || target.isContentEditable);
            
            if (!isTyping && e.key === "/") {
                e.preventDefault();
                input?.focus();
            } else if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") {
                e.preventDefault();
                input?.focus();
            } else if (e.key === "Escape" && document.activeElement === input) {
                input?.blur();
            }
        }

        document.addEventListener("keydown", handleKeydown);
    }

    document.addEventListener("astro:page-load", initTheoryFilter);
</script>

<style>
    .content-section {
        max-width: 800px;
        margin: 0 auto;
    }

    .topic-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: -10px;
        margin-bottom: var(--spacing-md);
    }

    .meta-pill {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        font-size: 0.8rem;
        color: var(--text-muted);
        background: var(--bg-secondary);
        border: 1px solid var(--border-color);
        padding: 3px 8px;
        border-radius: var(--radius);
    }

    .search-container {
        margin-bottom: var(--spacing-md);
    }

    .search-input-wrapper {
        position: relative;
        display: flex;
        align-items: center;
    }

    .search-icon {
        position: absolute;
        left: 14px;
        width: 18px;
        height: 18px;
        color: var(--text-muted);
        pointer-events: none;
    }

    #theorySearch {
        width: 100%;
        padding: 12px 68px 12px 42px;
        font-family: var(--font-family);
        font-size: 1rem;
        color: var(--text-primary);
        background: var(--bg-secondary);
        border: var(--border-width) solid var(--border-color);
        border-radius: var(--radius);
        outline: none;
        box-shadow: 2px 2px 0 var(--shadow-color);
        transition: all var(--transition);
        -webkit-appearance: none;
        appearance: none;
    }

    /* Disable native search cancel / clear buttons */
    #theorySearch::-webkit-search-cancel-button,
    #theorySearch::-webkit-search-decoration,
    #theorySearch::-webkit-search-results-button,
    #theorySearch::-webkit-search-results-decoration {
        -webkit-appearance: none;
        appearance: none;
        display: none;
    }

    #theorySearch:focus {
        border-color: var(--accent);
        box-shadow: 4px 4px 0 var(--shadow-color);
    }

    .search-kbd {
        position: absolute;
        right: 14px;
        font-family: var(--font-family);
        font-size: 0.8rem;
        color: var(--text-muted);
        background: var(--bg-primary);
        border: 1px solid var(--border-color);
        padding: 2px 6px;
        border-radius: var(--radius);
        pointer-events: none;
        box-shadow: 1px 1px 0 var(--shadow-color);
        align-items: center;
        justify-content: center;
    }

    .clear-btn {
        position: absolute;
        right: 10px;
        background: transparent;
        border: none;
        padding: 6px;
        cursor: pointer;
        color: var(--text-muted);
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: var(--radius);
        transition: color var(--transition), transform var(--transition);
    }

    .clear-btn:hover {
        color: var(--text-primary);
        transform: scale(1.1);
    }

    .clear-icon {
        width: 16px;
        height: 16px;
    }

    .search-count {
        font-size: 0.9rem;
        color: var(--text-muted);
        margin-top: 6px;
        min-height: 1.2em;
    }

    .no-results {
        padding: var(--spacing-lg);
        text-align: center;
        background: var(--bg-secondary);
        border: var(--border-width) solid var(--border-color);
        box-shadow: var(--shadow-offset) var(--shadow-offset) 0 var(--shadow-color);
        margin-top: var(--spacing-lg);
    }

    .theory-section {
        margin-bottom: var(--spacing-xl);
    }

    .properties-container {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-md);
    }

    @media (max-width: 480px) {
        .search-kbd {
            display: none !important;
        }
        #theorySearch {
            padding-right: 42px;
        }
    }
</style>
