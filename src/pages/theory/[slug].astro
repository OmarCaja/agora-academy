---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import PropertyBox from "../../components/PropertyBox.astro";
import TableOfContents from "../../components/TableOfContents.astro";

export async function getStaticPaths() {
    const topics = await getCollection("topics");
    return topics.map((entry) => ({
        params: { slug: entry.id },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { title, description, sections } = entry.data;

// Detailed Course/LearningResource Schema
const topicSchema = {
    "@context": "https://schema.org",
    "@type": "LearningResource",
    name: title,
    description: description,
    learningResourceType: "Tutorial",
    educationalLevel: ["ESO", "Bachillerato"],
    inLanguage: "es",
    author: {
        "@type": "Organization",
        name: "Ágora Academia",
    },
    hasPart: sections.map((section) => ({
        "@type": "LearningResource",
        name: section.title,
        learningResourceType: "Section",
    })),
};

// Helper to create URL-friendly IDs (must match TableOfContents.astro)
const slugify = (text: string) => {
    return text
        .toLowerCase()
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .replace(/[^\w ]+/g, "")
        .replace(/ +/g, "-");
};
---

<BaseLayout
    title={`${title} - Ágora`}
    description={description ||
        `Aprende sobre ${title} en Ágora Academia de Matemáticas.`}
    currentPage={`theory/${entry.id}`}
    schema={topicSchema}
>
    <div class="content-section">
        <Header title={title.toUpperCase()} />

        <TableOfContents sections={sections} />

        {
            sections.map((section) => (
                <section id={slugify(section.title)} class="fade-in">
                    <h2>{section.title}</h2>
                    {section.items.map((item) => (
                        <PropertyBox
                            title={item.title}
                            formula={item.formula}
                            example={item.example}
                            description={item.description}
                        />
                    ))}
                </section>
            ))
        }
    </div>
</BaseLayout>

<style>
    .content-section {
        max-width: 800px;
        margin: 0 auto;
    }
</style>
