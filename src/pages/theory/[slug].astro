---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import PropertyBox from "../../components/PropertyBox.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import TopicPager from "../../components/TopicPager.astro";
import SearchBox from "../../components/SearchBox.astro";
import NoResults from "../../components/NoResults.astro";
import { sortTopics } from "../../data/topics";
import { BOOKS } from "../../data/books";
import { slugify } from "../../utils/slugify";
import { Icon } from "astro-icon/components";
import { SITE_NAME } from "../../data/site";

export async function getStaticPaths() {
    const topics = await getCollection("topics");
    return topics.map((entry) => ({
        params: { slug: entry.id },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { title, description, sections, menuGroup } = entry.data;

const allTopics = sortTopics(await getCollection("topics"));

const currentIndex = allTopics.findIndex((t) => t.id === entry.id);
const prevEntry = currentIndex > 0 ? allTopics[currentIndex - 1] : undefined;
const nextEntry = currentIndex < allTopics.length - 1 ? allTopics[currentIndex + 1] : undefined;

const prevTopic = prevEntry
    ? { title: prevEntry.data.title, slug: `theory/${prevEntry.id}`, group: prevEntry.data.menuGroup }
    : undefined;
const nextTopic = nextEntry
    ? { title: nextEntry.data.title, slug: `theory/${nextEntry.id}`, group: nextEntry.data.menuGroup }
    : undefined;

// Calculate metadata stats
let totalItems = 0;
let totalFormulas = 0;
let totalWords = (description || "").split(/\s+/).filter(Boolean).length;

for (const sec of sections) {
    totalWords += (sec.title || "").split(/\s+/).filter(Boolean).length;
    for (const item of sec.items) {
        totalItems++;
        if (item.formula) totalFormulas++;
        if (item.description) {
            totalWords += item.description.replace(/<[^>]*>/g, " ").split(/\s+/).filter(Boolean).length;
        }
        if (item.example) {
            totalWords += item.example.replace(/<[^>]*>/g, " ").split(/\s+/).filter(Boolean).length;
        }
    }
}

const book = BOOKS.find((b) => b.topics.includes(entry.id));

const estimatedReadTime = Math.max(1, Math.ceil(totalWords / 150));

// Detailed Course/LearningResource Schema
const topicSchema = {
    "@context": "https://schema.org",
    "@type": "LearningResource",
    name: title,
    description: description,
    learningResourceType: "Tutorial",
    educationalLevel: ["ESO", "Bachillerato"],
    inLanguage: "es",
    author: {
        "@type": "Organization",
        name: SITE_NAME,
    },
    hasPart: sections.map((section) => ({
        "@type": "LearningResource",
        name: section.title,
        learningResourceType: "Section",
    })),
};
---

<BaseLayout
    title={`${title}`}
    description={description ||
        `Aprende sobre ${title} en ${SITE_NAME}.`}
    currentPage={`theory/${entry.id}`}
    schema={topicSchema}
    showProgressBar={true}
>
    <div class="content-section measure">
        <Breadcrumbs
            items={[
                { label: "Inicio", href: "/" },
                { label: "Teoría", href: "/theory/" },
                ...(menuGroup && menuGroup !== title ? [{ label: menuGroup }] : []),
                { label: title },
            ]}
        />

        <Header title={title.toUpperCase()} />

        <div class="topic-meta">
            <p class="topic-stats">
                ~{estimatedReadTime} min de lectura · {sections.length} {sections.length === 1 ? "sección" : "secciones"}
                {totalFormulas > 0 && ` · ${totalFormulas} ${totalFormulas === 1 ? "fórmula" : "fórmulas"}`}
            </p>
            {book && (
                <a class="pdf-button" href={book.url} target="_blank" rel="noopener noreferrer">
                    <Icon name="ph:file-pdf" aria-hidden="true" />
                    Descargar en PDF
                </a>
            )}
        </div>

        <SearchBox
            placeholder="Buscar en este tema..."
            label="Buscar en este tema (pulsa / para enfocar)"
            countSingular="resultado encontrado"
            countPlural="resultados encontrados"
        />

        <div id="tocWrapper">
            <TableOfContents sections={sections} />
        </div>

        <div id="theoryContent">
            {
                sections.map((section) => (
                    <section
                        id={slugify(section.title)}
                        class="theory-section reveal"
                        data-search-section
                        data-search-text={section.title}
                    >
                        <h2>{section.title}</h2>
                        <div class="properties-container">
                            {section.items.map((item) => (
                                <div
                                    class="property-item"
                                    data-search-item
                                    data-search-text={[
                                        item.title,
                                        item.description,
                                        item.example,
                                        item.formula,
                                    ]
                                        .filter(Boolean)
                                        .join(" ")}
                                >
                                    <PropertyBox
                                        title={item.title}
                                        formula={item.formula}
                                        example={item.example}
                                        description={item.description}
                                    />
                                </div>
                            ))}
                        </div>
                    </section>
                ))
            }
        </div>

        <NoResults message="No se han encontrado contenidos que coincidan con la búsqueda." />

        <TopicPager prev={prevTopic} next={nextTopic} />
    </div>
</BaseLayout>

<style>
    .topic-meta {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: var(--spacing-xs) var(--spacing-md);
        margin-top: -20px;
        margin-bottom: var(--spacing-md);
    }

    /* Facts about the page, not controls: plain text, no box. */
    .topic-stats {
        margin: 0;
        font-size: var(--font-size-sm);
        color: var(--text-muted);
    }

    .pdf-button {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        min-height: 44px;
        padding: 0 var(--spacing-sm);
        font-size: var(--font-size-sm);
        font-weight: 700;
        color: var(--text-primary);
        text-decoration: none;
        white-space: nowrap;
        border: var(--border-width) solid var(--border-color);
        box-shadow: 3px 3px 0 var(--shadow-color);
        transition:
            transform var(--transition),
            box-shadow var(--transition);
    }

    .pdf-button :global(svg) {
        width: 17px;
        height: 17px;
        flex-shrink: 0;
    }

    .pdf-button:hover {
        transform: translate(-2px, -2px);
        box-shadow: 5px 5px 0 var(--shadow-color);
    }

    .pdf-button:active {
        transform: translate(1px, 1px);
        box-shadow: 1px 1px 0 var(--shadow-color);
    }

    .theory-section {
        margin-bottom: var(--spacing-xl);
    }

    .properties-container {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-md);
    }
</style>
