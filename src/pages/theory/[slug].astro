---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import PropertyBox from "../../components/PropertyBox.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import TopicPager from "../../components/TopicPager.astro";
import SearchBox from "../../components/SearchBox.astro";
import { GROUP_ORDER } from "../../data/topics";
import { slugify } from "../../utils/slugify";
import { Icon } from "astro-icon/components";

export async function getStaticPaths() {
    const topics = await getCollection("topics");
    return topics.map((entry) => ({
        params: { slug: entry.id },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { title, description, sections, menuGroup } = entry.data;

const allTopics = await getCollection("topics");

allTopics.sort((a, b) => {
    const groupIndexA = GROUP_ORDER.indexOf(a.data.menuGroup || "");
    const groupIndexB = GROUP_ORDER.indexOf(b.data.menuGroup || "");
    if (groupIndexA !== groupIndexB) {
        if (groupIndexA === -1) return 1;
        if (groupIndexB === -1) return -1;
        return groupIndexA - groupIndexB;
    }
    const orderA = a.data.menuOrder ?? 999;
    const orderB = b.data.menuOrder ?? 999;
    if (orderA !== orderB) return orderA - orderB;
    return a.data.title.localeCompare(b.data.title, "es");
});

const currentIndex = allTopics.findIndex((t) => t.id === entry.id);
const prevEntry = currentIndex > 0 ? allTopics[currentIndex - 1] : undefined;
const nextEntry = currentIndex < allTopics.length - 1 ? allTopics[currentIndex + 1] : undefined;

const prevTopic = prevEntry
    ? { title: prevEntry.data.title, slug: `theory/${prevEntry.id}`, group: prevEntry.data.menuGroup }
    : undefined;
const nextTopic = nextEntry
    ? { title: nextEntry.data.title, slug: `theory/${nextEntry.id}`, group: nextEntry.data.menuGroup }
    : undefined;

// Calculate metadata stats
let totalItems = 0;
let totalFormulas = 0;
let totalWords = (description || "").split(/\s+/).filter(Boolean).length;

for (const sec of sections) {
    totalWords += (sec.title || "").split(/\s+/).filter(Boolean).length;
    for (const item of sec.items) {
        totalItems++;
        if (item.formula) totalFormulas++;
        if (item.description) {
            totalWords += item.description.replace(/<[^>]*>/g, " ").split(/\s+/).filter(Boolean).length;
        }
        if (item.example) {
            totalWords += item.example.replace(/<[^>]*>/g, " ").split(/\s+/).filter(Boolean).length;
        }
    }
}

const estimatedReadTime = Math.max(1, Math.ceil(totalWords / 150));

// Detailed Course/LearningResource Schema
const topicSchema = {
    "@context": "https://schema.org",
    "@type": "LearningResource",
    name: title,
    description: description,
    learningResourceType: "Tutorial",
    educationalLevel: ["ESO", "Bachillerato"],
    inLanguage: "es",
    author: {
        "@type": "Organization",
        name: "Academia Ágora",
    },
    hasPart: sections.map((section) => ({
        "@type": "LearningResource",
        name: section.title,
        learningResourceType: "Section",
    })),
};
---

<BaseLayout
    title={`${title} - Ágora`}
    description={description ||
        `Aprende sobre ${title} en Academia Ágora de Matemáticas.`}
    currentPage={`theory/${entry.id}`}
    schema={topicSchema}
    showProgressBar={true}
>
    <div class="content-section measure">
        <Breadcrumbs
            items={[
                { label: "Inicio", href: "/" },
                { label: "Teoría" },
                ...(menuGroup && menuGroup !== title ? [{ label: menuGroup }] : []),
                { label: title },
            ]}
        />

        <Header title={title.toUpperCase()} />

        <div class="topic-meta">
            <span class="meta-pill">
                <Icon name="ph:clock" aria-hidden="true" />
                ~{estimatedReadTime} min de lectura
            </span>
            <span class="meta-pill">
                <Icon name="ph:list" aria-hidden="true" />
                {sections.length} {sections.length === 1 ? "sección" : "secciones"}
            </span>
            {totalFormulas > 0 && (
                <span class="meta-pill">
                    <Icon name="ph:function" aria-hidden="true" />
                    {totalFormulas} {totalFormulas === 1 ? "fórmula" : "fórmulas"}
                </span>
            )}
        </div>

        <SearchBox
            placeholder="Buscar en este tema..."
            label="Buscar en este tema (pulsa / para enfocar)"
            countSingular="resultado encontrado"
            countPlural="resultados encontrados"
        />

        <div id="tocWrapper">
            <TableOfContents sections={sections} />
        </div>

        <div id="theoryContent">
            {
                sections.map((section) => (
                    <section
                        id={slugify(section.title)}
                        class="theory-section reveal"
                        data-search-section
                        data-search-text={section.title}
                    >
                        <h2>{section.title}</h2>
                        <div class="properties-container">
                            {section.items.map((item) => (
                                <div
                                    class="property-item"
                                    data-search-item
                                    data-search-text={[
                                        item.title,
                                        item.description,
                                        item.example,
                                        item.formula,
                                    ]
                                        .filter(Boolean)
                                        .join(" ")}
                                >
                                    <PropertyBox
                                        title={item.title}
                                        formula={item.formula}
                                        example={item.example}
                                        description={item.description}
                                    />
                                </div>
                            ))}
                        </div>
                    </section>
                ))
            }
        </div>

        <div id="noResults" class="no-results" style="display: none;">
            <p>No se han encontrado contenidos que coincidan con la búsqueda.</p>
        </div>

        <TopicPager prev={prevTopic} next={nextTopic} />
    </div>
</BaseLayout>

<style>
    .topic-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: -10px;
        margin-bottom: var(--spacing-md);
    }

    .meta-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-size: 0.82rem;
        color: var(--text-muted);
        background: var(--bg-secondary);
        border: 1px solid var(--rule-color);
        padding: 4px 10px;
        border-radius: var(--radius);
    }

    .meta-pill :global(svg) {
        width: 14px;
        height: 14px;
        flex-shrink: 0;
        color: var(--accent);
    }

    .no-results {
        padding: var(--spacing-lg);
        text-align: center;
        background: var(--bg-secondary);
        border: var(--border-width) solid var(--border-color);
        box-shadow: var(--shadow-offset) var(--shadow-offset) 0 var(--shadow-color);
        margin-top: var(--spacing-lg);
    }

    .theory-section {
        margin-bottom: var(--spacing-xl);
    }

    .properties-container {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-md);
    }
</style>
