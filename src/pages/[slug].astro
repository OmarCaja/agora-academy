---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import PropertyBox from "../components/PropertyBox.astro";

export async function getStaticPaths() {
    const topics = await getCollection("topics");
    return topics.map((entry) => ({
        params: { slug: entry.id },
        props: { entry },
    }));
}

const { entry } = Astro.props;
const { title, description, sections } = entry.data;
---

<BaseLayout
    title={`${title} - Ágora`}
    description={description ||
        `Aprende sobre ${title} en Ágora Academia de Matemáticas.`}
    currentPage={entry.id}
>
    <Header title={title.toUpperCase()} />
    <div class="content-section">
        {
            sections.map((section) => (
                <section class="fade-in">
                    <h2>{section.title}</h2>
                    {section.items.map((item) => (
                        <PropertyBox
                            title={item.title}
                            formula={item.formula}
                            example={item.example}
                            description={item.description}
                        />
                    ))}
                </section>
            ))
        }
    </div>
</BaseLayout>

<style>
    .content-section {
        max-width: 800px;
        margin: 0 auto;
    }
</style>
