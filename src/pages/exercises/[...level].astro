---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import SearchBox from "../../components/SearchBox.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import { discoverAllExercises } from "../../utils/discoverExercises";
import { slugify } from "../../utils/slugify";
import PdfList from "../../components/PdfList.astro";
import NoResults from "../../components/NoResults.astro";

export async function getStaticPaths() {
    return Object.keys(discoverAllExercises()).map((level) => ({
        params: { level },
    }));
}

const { level } = Astro.params;
const data = level ? discoverAllExercises()[level] : null;

if (!data) {
    throw new Error(`Data not found for level: ${level}`);
}
---

<BaseLayout
    title={`Ejercicios de ${data.subject.toLowerCase()} ${data.title}`}
    description={`Ejercicios de ${data.subject.toLowerCase()} para ${data.title}`}
    currentPage={`exercises/${level}`}
    showProgressBar={true}
>
    <div class="content-section measure">
        <Breadcrumbs
            items={[
                { label: "Inicio", href: "/" },
                { label: "Ejercicios", href: "/exercises/" },
                { label: data.subject },
                { label: data.title },
            ]}
        />
        <Header title={`EJERCICIOS DE ${data.subject.toUpperCase()} ${data.title.toUpperCase()}`} />

        <SearchBox
            placeholder="Buscar ejercicios..."
            label="Buscar ejercicios (pulsa / para enfocar)"
            countSingular="ejercicio encontrado"
            countPlural="ejercicios encontrados"
        />

        <div id="tocWrapper">
            <TableOfContents sections={data.topics} />
        </div>

        <div id="topicsContainer">
            {
                data.topics.map((topic) => (
                    <section
                        id={slugify(topic.title)}
                        class="topic-section reveal"
                        data-search-section
                        data-search-text={topic.title}
                    >
                        <div class="topic-heading">
                            <h2>{topic.title}</h2>
                            <span class="topic-count meta-label">
                                {topic.pdfs.length} {topic.pdfs.length === 1 ? "ejercicio" : "ejercicios"}
                            </span>
                        </div>
                        <PdfList pdfs={topic.pdfs} />
                    </section>
                ))
            }
        </div>

        <NoResults message="No se han encontrado ejercicios que coincidan con la búsqueda." />
    </div>
</BaseLayout>

<style>
    .topic-section {
        margin-bottom: var(--spacing-xl);
    }

    .topic-heading {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: var(--spacing-sm);
        flex-wrap: wrap;
        padding-bottom: var(--spacing-xs);
        margin-bottom: var(--spacing-md);
        border-bottom: 2px solid var(--accent);
    }

    .topic-heading h2 {
        margin-bottom: 0;
    }

    .topic-count {
        color: var(--text-muted);
        white-space: nowrap;
    }
</style>
