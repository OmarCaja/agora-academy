---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import { exercisesData } from "../../data/exercises";
import { slugify } from "../../utils/slugify";

export async function getStaticPaths() {
    return Object.keys(exercisesData).map((level) => ({
        params: { level },
    }));
}

const { level } = Astro.params;
const data = exercisesData[level];

if (!data) {
    throw new Error(`Data not found for level: ${level}`);
}
---

<BaseLayout
    title={`Ejercicios ${data.title} - Ágora`}
    description={`Ejercicios de matemáticas para ${data.title}`}
    currentPage={`exercises/${level}`}
>
    <div class="content-section">
        <Header title={`EJERCICIOS ${data.title.toUpperCase()}`} />

        <TableOfContents sections={data.topics} />

        {
            data.topics.map((topic) => (
                <section
                    id={slugify(topic.title)}
                    class="topic-section fade-in"
                >
                    <h2>{topic.title}</h2>
                    <ul class="pdf-list">
                        {topic.pdfs.map((pdf) => (
                            <li>
                                <a
                                    href={pdf.url}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    class="pdf-link"
                                >
                                    <div class="pdf-icon-wrapper">
                                        <svg
                                            xmlns="http://www.w3.org/2000/svg"
                                            viewBox="0 0 24 24"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="2"
                                            stroke-linecap="round"
                                            stroke-linejoin="round"
                                            class="pdf-icon"
                                        >
                                            <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z" />
                                            <polyline points="14 2 14 8 20 8" />
                                        </svg>
                                    </div>
                                    <span class="pdf-text">{pdf.name}</span>
                                    <span class="arrow">→</span>
                                </a>
                            </li>
                        ))}
                    </ul>
                </section>
            ))
        }
    </div>
</BaseLayout>

<style>
    .content-section {
        max-width: 800px;
        margin: 0 auto;
    }

    .topic-section {
        margin-bottom: var(--spacing-xl);
    }

    .pdf-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: var(--spacing-sm);
    }

    .pdf-link {
        display: flex;
        align-items: center;
        text-decoration: none;
        color: var(--text-primary);
        font-weight: 500;
        transition: all var(--transition);
        padding: 16px;
        border: 1px solid var(--border-color);
        border-radius: var(--radius);
        background: var(--bg-secondary);
        box-shadow: 2px 2px 0 var(--shadow-color);
    }

    .pdf-link:hover {
        background: var(--bg-primary);
        border-color: var(--accent);
        transform: translate(-2px, -2px);
        box-shadow: 4px 4px 0 var(--shadow-color);
    }

    .pdf-icon-wrapper {
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 15px;
        color: var(--text-muted);
        transition: color var(--transition);
        background: var(--bg-primary);
        padding: 8px;
        border-radius: var(--radius);
        border: 1px solid var(--nav-border);
    }

    .pdf-icon {
        width: 24px;
        height: 24px;
    }

    .pdf-link:hover .pdf-icon-wrapper {
        color: var(--accent);
        border-color: var(--accent);
    }

    .pdf-text {
        flex: 1;
        font-size: 1.05rem;
    }

    .arrow {
        font-weight: bold;
        opacity: 0.5;
        transition: all var(--transition);
        color: var(--accent);
        font-size: 1.2rem;
    }

    .pdf-link:hover .arrow {
        opacity: 1;
        transform: translateX(5px);
    }
</style>
