---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import SearchBox from "../../components/SearchBox.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import { discoverExercises } from "../../utils/discoverExercises";
import { slugify } from "../../utils/slugify";
import { Icon } from "astro-icon/components";

export async function getStaticPaths() {
    const exercisesData = discoverExercises();
    return Object.keys(exercisesData).map((level) => ({
        params: { level },
    }));
}

const { level } = Astro.params;
const exercisesData = discoverExercises();
const data = level ? exercisesData[level] : null;

if (!data) {
    throw new Error(`Data not found for level: ${level}`);
}
---

<BaseLayout
    title={`Ejercicios ${data.title} - Ágora`}
    description={`Ejercicios de matemáticas para ${data.title}`}
    currentPage={`exercises/${level}`}
    showProgressBar={true}
>
    <div class="content-section measure">
        <Breadcrumbs
            items={[
                { label: "Inicio", href: "/" },
                { label: "Ejercicios" },
                { label: data.title },
            ]}
        />
        <Header title={`EJERCICIOS ${data.title.toUpperCase()}`} />

        <SearchBox
            placeholder="Buscar ejercicios..."
            label="Buscar ejercicios (pulsa / para enfocar)"
            countSingular="ejercicio encontrado"
            countPlural="ejercicios encontrados"
        />

        <div id="tocWrapper">
            <TableOfContents sections={data.topics} />
        </div>

        <div id="topicsContainer">
            {
                data.topics.map((topic) => (
                    <section
                        id={slugify(topic.title)}
                        class="topic-section reveal"
                        data-search-section
                        data-search-text={topic.title}
                    >
                        <div class="topic-heading">
                            <h2>{topic.title}</h2>
                            <span class="topic-count">
                                {topic.pdfs.length} {topic.pdfs.length === 1 ? "ejercicio" : "ejercicios"}
                            </span>
                        </div>
                        <ul class="pdf-list">
                            {topic.pdfs.map((pdf) => (
                                <li data-search-item data-search-text={pdf.name}>
                                    <a
                                        href={pdf.url}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="pdf-link"
                                    >
                                        <div class="pdf-icon-wrapper">
                                            <Icon name="ph:file-pdf" class="pdf-icon" aria-hidden="true" />
                                        </div>
                                        <span class="pdf-text">{pdf.name}</span>
                                        <Icon name="ph:arrow-right" class="arrow" aria-hidden="true" />
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </section>
                ))
            }
        </div>

        <div id="noResults" class="no-results" style="display: none;">
            <p>No se han encontrado ejercicios que coincidan con la búsqueda.</p>
        </div>
    </div>
</BaseLayout>

<style>
    .no-results {
        padding: var(--spacing-lg);
        text-align: center;
        background: var(--bg-secondary);
        border: var(--border-width) solid var(--border-color);
        box-shadow: var(--shadow-offset) var(--shadow-offset) 0 var(--shadow-color);
        margin-top: var(--spacing-lg);
    }

    .topic-section {
        margin-bottom: var(--spacing-xl);
    }

    .topic-heading {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: var(--spacing-sm);
        flex-wrap: wrap;
        padding-bottom: var(--spacing-xs);
        margin-bottom: var(--spacing-md);
        border-bottom: 2px solid var(--accent);
    }

    .topic-heading h2 {
        margin-bottom: 0;
    }

    .topic-count {
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--text-muted);
        white-space: nowrap;
    }

    .pdf-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: var(--spacing-sm);
    }

    .pdf-link {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-sm);
        height: 100%;
        text-decoration: none;
        color: var(--text-primary);
        font-weight: 500;
        transition: all var(--transition);
        padding: var(--spacing-md);
        border: var(--border-width) solid var(--border-color);
        border-radius: var(--radius);
        background: var(--bg-secondary);
        box-shadow: var(--shadow-offset) var(--shadow-offset) 0 var(--shadow-color);
    }

    .pdf-link:hover {
        background: var(--bg-primary);
        border-color: var(--accent);
        transform: translate(-2px, -2px);
        box-shadow: calc(var(--shadow-offset) + 2px) calc(var(--shadow-offset) + 2px) 0 var(--shadow-color);
    }

    .pdf-icon-wrapper {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        color: var(--on-accent);
        transition: transform var(--transition);
        background: var(--accent);
        border-radius: var(--radius);
        border: 1px solid var(--accent);
    }

    :global(.pdf-icon) {
        width: 21px;
        height: 21px;
    }

    .pdf-link:hover .pdf-icon-wrapper {
        transform: scale(1.08);
    }

    .pdf-text {
        flex: 1;
        font-size: 1.05rem;
        line-height: 1.35;
    }

    :global(.arrow) {
        align-self: flex-end;
        width: 18px;
        height: 18px;
        opacity: 0.55;
        color: var(--accent);
        transition: opacity var(--transition), transform var(--transition);
    }

    .pdf-link:hover :global(.arrow) {
        opacity: 1;
        transform: translateX(5px);
    }
</style>
