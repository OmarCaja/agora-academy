---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import SearchBox from "../../components/SearchBox.astro";
import TableOfContents from "../../components/TableOfContents.astro";
import { discoverExercises } from "../../utils/discoverExercises";
import { slugify } from "../../utils/slugify";

export async function getStaticPaths() {
    const exercisesData = discoverExercises();
    return Object.keys(exercisesData).map((level) => ({
        params: { level },
    }));
}

const { level } = Astro.params;
const exercisesData = discoverExercises();
const data = level ? exercisesData[level] : null;

if (!data) {
    throw new Error(`Data not found for level: ${level}`);
}
---

<BaseLayout
    title={`Ejercicios ${data.title} - Ágora`}
    description={`Ejercicios de matemáticas para ${data.title}`}
    currentPage={`exercises/${level}`}
    showProgressBar={true}
>
    <div class="content-section">
        <Breadcrumbs
            items={[
                { label: "Inicio", href: "/" },
                { label: "Ejercicios" },
                { label: data.title },
            ]}
        />
        <Header title={`EJERCICIOS ${data.title.toUpperCase()}`} />

        <SearchBox
            placeholder="Buscar ejercicios..."
            label="Buscar ejercicios (pulsa / para enfocar)"
            countSingular="ejercicio encontrado"
            countPlural="ejercicios encontrados"
        />

        <div id="tocWrapper">
            <TableOfContents sections={data.topics} />
        </div>

        <div id="topicsContainer">
            {
                data.topics.map((topic) => (
                    <section
                        id={slugify(topic.title)}
                        class="topic-section fade-in"
                        data-search-section
                        data-search-text={topic.title}
                    >
                        <div class="topic-heading">
                            <h2>{topic.title}</h2>
                            <span class="topic-count">
                                {topic.pdfs.length} {topic.pdfs.length === 1 ? "ejercicio" : "ejercicios"}
                            </span>
                        </div>
                        <ul class="pdf-list">
                            {topic.pdfs.map((pdf) => (
                                <li data-search-item data-search-text={pdf.name}>
                                    <a
                                        href={pdf.url}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="pdf-link"
                                    >
                                        <div class="pdf-icon-wrapper">
                                            <svg
                                                xmlns="http://www.w3.org/2000/svg"
                                                viewBox="0 0 24 24"
                                                fill="none"
                                                stroke="currentColor"
                                                stroke-width="2"
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                class="pdf-icon"
                                            >
                                                <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z" />
                                                <polyline points="14 2 14 8 20 8" />
                                            </svg>
                                        </div>
                                        <span class="pdf-text">{pdf.name}</span>
                                        <span class="arrow">→</span>
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </section>
                ))
            }
        </div>

        <div id="noResults" class="no-results" style="display: none;">
            <p>No se han encontrado ejercicios que coincidan con la búsqueda.</p>
        </div>
    </div>
</BaseLayout>

<style>
    .content-section {
        max-width: 800px;
        margin: 0 auto;
    }

    .no-results {
        padding: var(--spacing-lg);
        text-align: center;
        background: var(--bg-secondary);
        border: var(--border-width) solid var(--border-color);
        box-shadow: var(--shadow-offset) var(--shadow-offset) 0 var(--shadow-color);
        margin-top: var(--spacing-lg);
    }

    .topic-section {
        margin-bottom: var(--spacing-xl);
    }

    .topic-heading {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: var(--spacing-sm);
        flex-wrap: wrap;
    }

    .topic-heading h2 {
        margin-bottom: 0;
    }

    .topic-count {
        font-size: 0.8rem;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: var(--text-muted);
        white-space: nowrap;
        margin-bottom: var(--spacing-md);
    }

    .pdf-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: var(--spacing-sm);
    }

    .pdf-link {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-sm);
        height: 100%;
        text-decoration: none;
        color: var(--text-primary);
        font-weight: 500;
        transition: all var(--transition);
        padding: var(--spacing-md);
        border: var(--border-width) solid var(--border-color);
        border-radius: var(--radius);
        background: var(--bg-secondary);
        box-shadow: var(--shadow-offset) var(--shadow-offset) 0 var(--shadow-color);
    }

    .pdf-link:hover {
        background: var(--bg-primary);
        border-color: var(--accent);
        transform: translate(-2px, -2px);
        box-shadow: calc(var(--shadow-offset) + 2px) calc(var(--shadow-offset) + 2px) 0 var(--shadow-color);
    }

    .pdf-icon-wrapper {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        color: var(--accent);
        transition: transform var(--transition);
        background: var(--bg-primary);
        border-radius: var(--radius);
        border: 1px solid var(--border-color);
    }

    .pdf-icon {
        width: 20px;
        height: 20px;
    }

    .pdf-link:hover .pdf-icon-wrapper {
        transform: scale(1.08);
    }

    .pdf-text {
        flex: 1;
        font-size: 1.05rem;
        line-height: 1.35;
    }

    .arrow {
        align-self: flex-end;
        font-weight: bold;
        opacity: 0.5;
        transition: all var(--transition);
        color: var(--accent);
        font-size: 1.2rem;
    }

    .pdf-link:hover .arrow {
        opacity: 1;
        transform: translateX(5px);
    }
</style>
