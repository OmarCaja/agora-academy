---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import BaseLayout from "../layouts/BaseLayout.astro";
import LevelTags from "../components/LevelTags.astro";
import ContactItem from "../components/ContactItem.astro";
import HeroTangent from "../components/HeroTangent.astro";
import { discoverExercises } from "../utils/discoverExercises";

// Real counts, computed at build from the actual content. Nothing here is a
// hand-written figure that can drift away from what the site ships.
const topics = await getCollection("topics");
const exercises = discoverExercises();

const pdfCount = (level: string) =>
    (exercises[level]?.topics ?? []).reduce((n, t) => n + t.pdfs.length, 0);

const levels = [
    {
        slug: "1-eso",
        label: "1º E.S.O.",
        desc: "Enteros, fracciones, álgebra y porcentajes",
    },
    {
        slug: "3-eso",
        label: "3º E.S.O.",
        desc: "Ecuaciones y problemas",
    },
    {
        slug: "4-eso",
        label: "4º E.S.O.",
        desc: "Funciones, gráficas y propiedades",
    },
    {
        slug: "1-bach",
        label: "1º Bachillerato",
        desc: "Límites, estadística, probabilidad y exámenes",
    },
].filter((l) => exercises[l.slug]);

const reasons = [
    {
        icon: "ph:users-three",
        title: "Grupos reducidos",
        body: "para una atención personalizada",
    },
    {
        icon: "ph:trend-up",
        title: "Mejora del aprendizaje",
        body: "con seguimiento del progreso de cada alumno",
    },
    {
        icon: "ph:tree-structure",
        title: "Razonamiento lógico",
        body: "como base del aprendizaje",
    },
    {
        icon: "ph:compass-tool",
        title: "Pensamiento abstracto",
        body: "aplicado a problemas reales",
    },
];
---

<BaseLayout
	title="Academia Ágora - Academia de matemáticas en Cuenca"
	description="Academia de matemáticas en Cuenca para Primaria, E.S.O. y Bachillerato. Grupos reducidos, atención personalizada y seguimiento cercano. Calle Fermín Caballero, 3."
	currentPage="index"
>
	<div class="content-section">
		{/* ── Hero: asymmetric split ───────────────────────────────── */}
		<section class="hero">
			<div class="hero-copy">
				<h1 class="hero-title reveal" style="--i: 0">
					Academia de matemáticas en Cuenca
				</h1>

				<p class="hero-lede reveal" style="--i: 1">
					Clases de refuerzo para <strong>Primaria</strong>, <strong
						>E.S.O.</strong
					> y <strong>Bachillerato</strong>, con grupos reducidos y
					seguimiento cercano de cada alumno.
				</p>

				<div class="hero-ctas reveal" style="--i: 2">
					<a href="/#contacto" class="btn btn-solid">
						Pedir información
						<Icon name="ph:arrow-right" aria-hidden="true" />
					</a>
					<a href="/theory/algebra" class="btn btn-line">
						Ver teoría
						<Icon name="ph:arrow-right" aria-hidden="true" />
					</a>
				</div>
			</div>

			<div class="hero-figure">
				<HeroTangent />
			</div>
		</section>

		{/* ── Statement: full-width, no card ───────────────────────── */}
		<section class="statement">
			<h2 class="reveal">Sobre nosotros</h2>
			<p class="statement-lead reveal" style="--i: 1">
				En <strong>Ágora</strong> nos especializamos en la enseñanza de
				matemáticas para estudiantes de Primaria, E.S.O. y Bachillerato
				en Cuenca. Con nuestros <strong>grupos reducidos</strong>, cada
				alumno recibe una atención personalizada y un seguimiento
				cercano de su progreso.
			</p>
			<div class="statement-levels reveal" style="--i: 2">
				<LevelTags />
			</div>
		</section>

		{/* ── Materials: bento, one cell per item ──────────────────── */}
		<section class="materials">
			<h2 class="reveal">Recursos y materiales</h2>
			<p class="section-lead reveal" style="--i: 1">
				Apuntes digitales, ejercicios resueltos y modelos de examen
				clasificados por nivel.
			</p>

			<div class="bento">
				<a href="/theory/algebra" class="cell cell-wide cell-accent reveal" style="--i: 2">
					<Icon name="ph:function" class="cell-icon" aria-hidden="true" />
					<span class="cell-title">Teoría</span>
					<span class="cell-desc">
						Apuntes y fórmulas de {topics.length} temas, con ejemplos
						resueltos y gráficas.
					</span>
					<span class="cell-action">
						Ver teoría
						<Icon name="ph:arrow-right" aria-hidden="true" />
					</span>
				</a>

				{
					levels.map((level, idx) => (
						<a
							href={`/exercises/${level.slug}`}
							class:list={[
								"cell",
								"reveal",
								{ "cell-tinted": idx === 3 },
							]}
							style={`--i: ${idx + 3}`}
						>
							<span class="cell-title">{level.label}</span>
							<span class="cell-desc">{level.desc}</span>
							<span class="cell-meta">
								{pdfCount(level.slug)} {pdfCount(level.slug) === 1 ? "PDF" : "PDFs"}
							</span>
							<span class="cell-action">
								Ver ejercicios
								<Icon name="ph:arrow-right" aria-hidden="true" />
							</span>
						</a>
					))
				}
			</div>
		</section>

		{/* ── Reasons: offset editorial stack, no cards ────────────── */}
		<section class="reasons">
			<h2 class="reveal">¿Por qué Ágora?</h2>

			<ol class="reason-stack">
				{
					reasons.map((reason, idx) => (
						<li class="reason reveal" style={`--i: ${idx}`}>
							<Icon
								name={reason.icon}
								class="reason-icon"
								aria-hidden="true"
							/>
							<div class="reason-text">
								<strong>{reason.title}</strong>
								<span>{reason.body}</span>
							</div>
						</li>
					))
				}
			</ol>
		</section>

		{/* ── Contact: two-column split ────────────────────────────── */}
		<section id="contacto" class="contact">
			<div class="contact-head reveal">
				<h2>Contacto</h2>
				<p>
					Escríbenos o llámanos y te contamos cómo trabajamos.
				</p>
			</div>

			<div class="contact-details reveal" style="--i: 1">
				<ContactItem label="Dirección">
					<Icon slot="icon" name="ph:map-pin" aria-hidden="true" />
					<address>
						<a
							href="https://www.google.com/maps/search/?api=1&query=Calle+Fermín+Caballero+3+Cuenca"
							target="_blank"
							rel="noopener noreferrer"
							class="map-link"
						>
							Calle Fermín Caballero, 3 (edificio Máster).<br />
							Planta 6 [thegoodspace].<br />
							Cuenca.
						</a>
					</address>
				</ContactItem>

				<ContactItem label="Teléfono">
					<Icon slot="icon" name="ph:phone" aria-hidden="true" />
					<a href="tel:+34649021173">649 021 173</a>
				</ContactItem>

				<ContactItem label="Email">
					<Icon
						slot="icon"
						name="ph:envelope-simple"
						aria-hidden="true"
					/>
					<a href="mailto:info@agoraacademy.es">info@agoraacademy.es</a>
				</ContactItem>
			</div>
		</section>
	</div>
</BaseLayout>

<style>
	/* ===== HERO ===== */
	.hero {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--spacing-lg);
		align-items: center;
		padding-top: var(--spacing-md);
		padding-bottom: var(--spacing-xl);
		margin-bottom: var(--spacing-lg);
		border-bottom: 1px solid var(--rule-color);
	}

	.hero-title {
		font-family: var(--font-family);
		font-weight: 700;
		font-size: var(--step-5);
		line-height: 1.08;
		letter-spacing: -0.035em;
		max-width: 15ch;
		margin-bottom: var(--spacing-md);
		text-wrap: balance;
	}

	.hero-lede {
		max-width: 46ch;
		color: var(--text-tertiary);
		font-size: var(--step-1);
		margin-bottom: var(--spacing-lg);
	}

	.hero-lede strong {
		color: var(--text-primary);
	}

	.hero-ctas {
		display: flex;
		flex-wrap: wrap;
		gap: var(--spacing-sm);
	}

	.hero-figure {
		justify-self: center;
		width: 100%;
		max-width: 300px;
	}

	@media (min-width: 900px) {
		.hero {
			/* Deliberately uneven: the message owns more of the page than the
			   figure, and the figure sits off the vertical centre line. */
			grid-template-columns: 1.25fr 0.75fr;
			gap: var(--spacing-2xl);
			padding-top: var(--spacing-lg);
			padding-bottom: var(--spacing-2xl);
		}

		.hero-figure {
			max-width: none;
			transform: translateY(8px);
		}
	}

	/* ===== BUTTONS ===== */
	.btn {
		display: inline-flex;
		align-items: center;
		gap: 9px;
		font-family: var(--font-family);
		font-weight: 700;
		font-size: 0.95rem;
		white-space: nowrap;
		text-decoration: none;
		padding: 13px 20px;
		border: var(--border-width) solid var(--border-color);
		box-shadow: 3px 3px 0 var(--shadow-color);
		transition:
			transform var(--transition),
			box-shadow var(--transition),
			background var(--transition),
			color var(--transition);
		-webkit-tap-highlight-color: transparent;
	}

	.btn :global(svg) {
		width: 17px;
		height: 17px;
		transition: transform var(--transition);
	}

	.btn-solid {
		background: var(--accent);
		border-color: var(--accent);
		color: var(--on-accent);
	}

	.btn-line {
		background: transparent;
		color: var(--text-primary);
	}

	.btn:hover {
		transform: translate(-2px, -2px);
		box-shadow: 5px 5px 0 var(--shadow-color);
	}

	.btn:hover :global(svg) {
		transform: translateX(3px);
	}

	.btn:active {
		transform: translate(1px, 1px);
		box-shadow: 1px 1px 0 var(--shadow-color);
	}

	/* ===== STATEMENT ===== */
	.statement-lead {
		font-size: var(--step-2);
		line-height: 1.45;
		max-width: 34ch;
		color: var(--text-secondary);
		letter-spacing: -0.015em;
	}

	.statement-lead strong {
		color: var(--text-primary);
	}

	.statement-levels {
		margin-top: var(--spacing-md);
	}

	@media (min-width: 900px) {
		.statement-lead {
			max-width: 30ch;
			margin-left: auto;
			margin-right: 0;
			text-align: right;
		}

		.statement-levels {
			display: flex;
			justify-content: flex-end;
		}
	}

	/* ===== SECTION LEAD ===== */
	.section-lead {
		max-width: 52ch;
		color: var(--text-muted);
		margin-bottom: var(--spacing-lg);
	}

	/* ===== BENTO ===== */
	.bento {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--spacing-sm);
	}

	@media (min-width: 640px) {
		.bento {
			grid-template-columns: repeat(2, 1fr);
		}

		.cell-wide {
			grid-column: span 2;
		}
	}

	@media (min-width: 960px) {
		.bento {
			grid-template-columns: repeat(3, 1fr);
		}

		.cell-wide {
			grid-column: span 2;
		}
	}

	.cell {
		position: relative;
		isolation: isolate;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		gap: 5px;
		min-height: 168px;
		padding: 22px;
		background: var(--bg-secondary);
		border: var(--border-width) solid var(--border-color);
		border-radius: var(--radius);
		text-decoration: none;
		color: var(--text-primary);
		box-shadow: 3px 3px 0 var(--shadow-color);
		transition:
			transform var(--transition),
			box-shadow var(--transition),
			background var(--transition);
	}

	.cell:hover {
		transform: translate(-3px, -3px);
		box-shadow: 6px 6px 0 var(--shadow-color);
	}

	.cell-wide {
		min-height: 210px;
		justify-content: flex-end;
	}

	.cell-accent {
		background: var(--accent);
		border-color: var(--accent);
		color: var(--on-accent);
	}

	.cell-tinted {
		background: var(--accent-tint);
	}

	.cell-icon {
		width: 30px;
		height: 30px;
		margin-bottom: auto;
	}

	.cell-title {
		font-size: var(--step-2);
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.15;
	}

	.cell-desc {
		font-size: 0.9rem;
		line-height: 1.45;
		color: var(--text-muted);
	}

	.cell-accent .cell-desc {
		color: var(--on-accent);
		opacity: 0.88;
	}

	.cell-meta {
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--text-muted);
		margin-top: 4px;
	}

	.cell-action {
		display: inline-flex;
		align-items: center;
		gap: 7px;
		margin-top: auto;
		padding-top: var(--spacing-sm);
		font-size: 0.88rem;
		font-weight: 700;
		color: var(--accent-strong);
	}

	.cell-accent .cell-action {
		color: var(--on-accent);
	}

	.cell-action :global(svg) {
		width: 15px;
		height: 15px;
		transition: transform var(--transition);
	}

	.cell:hover .cell-action :global(svg) {
		transform: translateX(4px);
	}

	/* ===== REASONS ===== */
	.reason-stack {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
	}

	.reason {
		display: flex;
		align-items: flex-start;
		gap: var(--spacing-md);
		padding: var(--spacing-md) 0;
		border-top: 1px solid var(--rule-color);
	}

	.reason:last-child {
		border-bottom: 1px solid var(--rule-color);
	}

	.reason-icon {
		width: 26px;
		height: 26px;
		flex-shrink: 0;
		color: var(--accent);
		margin-top: 3px;
	}

	.reason-text {
		display: flex;
		flex-direction: column;
		gap: 2px;
	}

	.reason-text strong {
		font-size: var(--step-1);
		letter-spacing: -0.015em;
	}

	.reason-text span {
		color: var(--text-muted);
		font-size: 0.95rem;
	}

	/* Progressive indent gives the stack a diagonal edge instead of a
	   four-identical-rows rhythm. Collapses flat on mobile. */
	@media (min-width: 900px) {
		.reason {
			padding: var(--spacing-lg) 0;
			gap: var(--spacing-lg);
		}

		.reason:nth-child(2) {
			padding-left: 8%;
		}

		.reason:nth-child(3) {
			padding-left: 16%;
		}

		.reason:nth-child(4) {
			padding-left: 24%;
		}

		.reason-text strong {
			font-size: var(--step-2);
		}
	}

	/* ===== CONTACT ===== */
	.contact {
		display: grid;
		grid-template-columns: 1fr;
		gap: var(--spacing-lg);
		padding-top: var(--spacing-lg);
		border-top: var(--border-width) solid var(--border-color);
	}

	.contact-head p {
		max-width: 30ch;
		color: var(--text-muted);
		margin-bottom: 0;
	}

	@media (min-width: 900px) {
		.contact {
			grid-template-columns: 0.8fr 1.2fr;
			gap: var(--spacing-2xl);
		}

		.contact-head h2 {
			position: sticky;
			top: 84px;
		}
	}

	:global(.contact-item-head svg) {
		width: 19px;
		height: 19px;
		color: var(--accent);
		flex-shrink: 0;
	}
</style>
