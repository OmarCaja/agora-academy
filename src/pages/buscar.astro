---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import SearchBox from "../components/SearchBox.astro";
---

<BaseLayout
    title="Buscar"
    description="Busca definiciones, teoremas, propiedades y procedimientos de matemáticas en toda la web y abre el tema o el libro PDF en la página exacta."
    currentPage="buscar"
>
    <div class="content-section measure">
        <Breadcrumbs items={[{ label: "Inicio", href: "/" }, { label: "Buscar" }]} />
        <Header title="BUSCAR" />
        <p class="intro">Definiciones, teoremas y procedimientos de todos los temas, con enlace a la web y a la página del libro PDF.</p>
        <SearchBox
            placeholder="Buscar un concepto (p. ej. regla de Sarrus, mcd, Bayes)..."
            label="Buscar en toda la web (pulsa / para enfocar)"
            countSingular="resultado"
            countPlural="resultados"
            kinds
            external
        />
        <ol id="globalResults" class="results"></ol>
        <button type="button" id="moreResults" class="more" hidden>Mostrar más resultados</button>
        <div id="noResults" class="empty" hidden>
            <p>No se han encontrado contenidos que coincidan con la búsqueda.</p>
        </div>
    </div>
</BaseLayout>

<script>
    import "../scripts/global-search.js";
</script>

<style>
    .intro {
        color: var(--text-muted);
        margin-bottom: var(--spacing-md);
    }

    .results {
        list-style: none;
        margin: var(--spacing-md) 0 0;
        padding: 0;
        display: grid;
        gap: var(--spacing-sm);
    }

    .results :global(.result) {
        padding: var(--spacing-sm);
        background: var(--bg-secondary);
        border: var(--border-width) solid var(--border-color);
        box-shadow: 3px 3px 0 var(--shadow-color);
    }

    .results :global(.result-kind) {
        display: inline-block;
        padding: 1px 8px;
        border: var(--border-width) solid var(--border-color);
        margin-right: 8px;
    }

    .results :global(.result-kind.definicion) {
        color: var(--on-accent);
        background: var(--accent);
    }

    .results :global(.result-title) {
        font-weight: 700;
        font-size: var(--step-0);
    }

    .results :global(.result-where) {
        margin: 4px 0;
        font-size: var(--font-size-sm);
        color: var(--text-muted);
    }

    .results :global(.result-snippet) {
        margin: 0 0 var(--spacing-xs);
        font-size: var(--font-size-sm);
        line-height: 1.5;
        color: var(--text-tertiary);
    }

    .results :global(.result-links) {
        display: flex;
        flex-wrap: wrap;
        gap: var(--spacing-sm);
        font-size: var(--font-size-sm);
        font-weight: 700;
    }

    .results :global(.result-links a) {
        color: var(--text-primary);
        text-decoration: underline;
        text-underline-offset: 3px;
    }

    .results :global(mark) {
        background: var(--rule-color);
        color: inherit;
    }

    .more {
        display: block;
        margin: var(--spacing-md) auto 0;
        padding: 10px 18px;
        font-family: var(--font-family);
        font-weight: 700;
        color: var(--on-accent);
        background: var(--accent);
        border: var(--border-width) solid var(--border-color);
        cursor: pointer;
    }

    .empty {
        margin-top: var(--spacing-lg);
        padding: var(--spacing-lg);
        text-align: center;
        background: var(--bg-secondary);
        border: var(--border-width) solid var(--border-color);
    }
</style>
