---
import fs from "node:fs";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import PdfList from "../components/PdfList.astro";
import { formatDefaultTitle } from "../utils/discoverExercises";
import { pdfNameOverrides } from "../data/exercises";

// Book PDFs generated by scripts/build-book.mjs into public/libros/.
const books = fs
    .readdirSync("public/libros")
    .filter((f) => f.toLowerCase().endsWith(".pdf"))
    .map((f) => {
        const url = `/libros/${f}`;
        return { url, name: pdfNameOverrides[url] || formatDefaultTitle(f) };
    })
    .sort((a, b) => a.name.localeCompare(b.name, "es", { numeric: true }));
---

<BaseLayout
    title="Libros PDF - Academia Ágora"
    description="Libros de teoría de matemáticas en PDF para descargar: fórmulas, ejemplos resueltos y explicaciones."
    currentPage="books"
>
    <div class="content-section measure">
        <Breadcrumbs items={[{ label: "Inicio", href: "/" }, { label: "Libros PDF" }]} />
        <Header title="LIBROS PDF" />
        <p class="intro">La teoría de la web reunida en libros para descargar e imprimir.</p>
        <PdfList pdfs={books} />
    </div>
</BaseLayout>

<style>
    .intro {
        color: var(--text-muted);
        margin-bottom: var(--spacing-md);
    }
</style>
