---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import PdfList from "../components/PdfList.astro";
import { BOOKS } from "../data/books";
import { sortTopics } from "../data/topics";

// Books follow the site's topic order (by their first chapter) and list their chapters
// (skipped for single-chapter books, where it would just repeat the title).
const topics = sortTopics(await getCollection("topics"));
const rank = (slug: string) => topics.findIndex((t) => t.id === slug);
const books = [...BOOKS]
    .sort((a, b) => rank(a.topics[0]) - rank(b.topics[0]))
    .map((b) => ({
        url: b.url,
        name: b.title,
        detail:
            b.topics.length > 1
                ? b.topics.map((slug) => topics[rank(slug)]?.data.title ?? slug).join(" · ")
                : undefined,
    }));
---

<BaseLayout
    title="Libros PDF"
    description="Libros de teoría de matemáticas en PDF para descargar: fórmulas, ejemplos resueltos y explicaciones."
    currentPage="books"
>
    <div class="content-section measure">
        <Breadcrumbs items={[{ label: "Inicio", href: "/" }, { label: "Libros PDF" }]} />
        <Header title="LIBROS PDF" />
        <p class="intro">La teoría de la web reunida en libros para descargar e imprimir.</p>
        <PdfList pdfs={books} />
    </div>
</BaseLayout>

<style>
    .intro {
        color: var(--text-muted);
        margin-bottom: var(--spacing-md);
    }
</style>
