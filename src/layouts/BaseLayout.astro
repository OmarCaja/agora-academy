---
interface Props {
  title: string;
  description: string;
  currentPage?: string;
  schema?: object;
  showProgressBar?: boolean;
}

const { title, description, currentPage = "index", schema, showProgressBar = false } = Astro.props;

import GlobalNav from "../components/GlobalNav.astro";
import Menu from "../components/Menu.astro";
import Footer from "../components/Footer.astro";
import ReadingProgressBar from "../components/ReadingProgressBar.astro";
import ScrollToTop from "../components/ScrollToTop.astro";
import { ClientRouter } from "astro:transitions";
import "@fontsource/space-mono/400.css";
import "@fontsource/space-mono/700.css";
import "katex/dist/katex.min.css";
import "../styles/global.css";
---

<!doctype html>
<html lang="es">
  <head>
    <ClientRouter />
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />

    <!-- Theme color for Safari browser bars (light theme) -->
    <meta
      name="theme-color"
      content="#f4f4f4"
      media="(prefers-color-scheme: light)"
    />
    <!-- Theme color for Safari browser bars (dark theme) -->
    <meta
      name="theme-color"
      content="#1a1a1a"
      media="(prefers-color-scheme: dark)"
    />

    <title>
      {
        title.includes("Academia Ágora") || title.includes("Ágora")
          ? title
          : `${title} | Academia Ágora`
      }
    </title>

    <!-- SEO Meta Tags -->
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="academia matemáticas Cuenca, Primaria, ESO, Bachillerato, refuerzo escolar, matemáticas Cuenca"
    />
    <meta name="application-name" content="Academia Ágora" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />

    <!-- Favicon & Manifest -->
    <link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/favicon/apple-touch-icon.png"
    />
    <link rel="manifest" href="/favicon/site.webmanifest" />

    <!-- Open Graph -->
    <meta
      property="og:title"
      content={title.includes("Ágora") ? title : `${title} | Ágora`}
    />
    <meta property="og:description" content={description} />
    <meta
      property="og:image"
      content={new URL("/favicon/logo.png", Astro.site)}
    />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Academia Ágora" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta
      name="twitter:title"
      content={title.includes("Ágora") ? title : `${title} | Ágora`}
    />
    <meta name="twitter:description" content={description} />
    <meta
      name="twitter:image"
      content={new URL("/favicon/logo.png", Astro.site)}
    />

    <!-- KaTeX CSS -->
    <!-- (Imported in frontmatter for bundling) -->

    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebSite",
        "name": "Academia Ágora",
        "alternateName": ["Ágora", "Academia Agora", "Agora"],
        "url": Astro.site,
      })}
    />

    <!-- Structured Data (JSON-LD): LocalBusiness + optional page schema -->
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify([
        {
          "@context": "https://schema.org",
          "@type": "LocalBusiness",
          name: "Academia Ágora",
          image: `${Astro.site}/favicon/logo.png`,
          "@id": Astro.site,
          url: Astro.site,
          telephone: "+34649021173",
          email: "info@agoraacademy.es",
          address: {
            "@type": "PostalAddress",
            streetAddress:
              "Calle Fermín Caballero, 3, Planta 6, espacio Einstein",
            addressLocality: "Cuenca",
            postalCode: "16004",
            addressCountry: "ES",
          },
          geo: {
            "@type": "GeoCoordinates",
            latitude: 40.071,
            longitude: -2.137,
          },
          openingHoursSpecification: {
            "@type": "OpeningHoursSpecification",
            dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
            opens: "18:00",
            closes: "20:00",
          },
            description:
            "Academia especializada en matemáticas para Primaria, E.S.O. y Bachillerato en Cuenca. Grupos reducidos y atención personalizada.",
        },
        ...(schema ? [schema] : []),
      ])}
    />

    <script is:inline>
      const getTheme = () => {
        const stored =
          typeof localStorage !== "undefined" && localStorage.getItem("theme");
        if (stored) return stored;
        return window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light";
      };

      const updateUI = (theme) => {
        const text = document.getElementById("themeText");
        if (text)
          text.textContent =
            theme === "dark" ? "Cambiar a tema claro" : "Cambiar a tema oscuro";
      };

      window.setTheme = (theme) => {
        document.documentElement.setAttribute("data-theme", theme);
        updateUI(theme);
      };

      window.updateThemeUI = updateUI;
      window.getTheme = getTheme;

      // Initial apply
      window.setTheme(getTheme());

      document.addEventListener("astro:after-swap", () =>
        window.setTheme(getTheme()),
      );

      // Prevent theme flicker by setting the theme on the new document before swap
      document.addEventListener("astro:before-swap", (ev) => {
        const theme = getTheme();
        ev.newDocument.documentElement.setAttribute("data-theme", theme);
      });
    </script>
  </head>

  <body>
    <a href="#main-content" class="skip-link">Saltar al contenido</a>
    <GlobalNav transition:persist />
    {showProgressBar && <ReadingProgressBar transition:persist />}
    <Menu currentPage={currentPage} transition:persist />

    <main id="main-content" class="container">
      <slot />
      <Footer />
    </main>

    <ScrollToTop transition:persist />

    <script>
      import "../scripts/animations.js";
    </script>
  </body>
</html>
