---
interface Props {
  title: string;
  description: string;
  currentPage?: string;
}

const { title, description, currentPage = "index" } = Astro.props;

import GlobalNav from "../components/GlobalNav.astro";
import Menu from "../components/Menu.astro";
import Footer from "../components/Footer.astro";
import { ClientRouter } from "astro:transitions";
---

<!doctype html>
<html lang="es">
  <head>
    <ClientRouter />
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />

    <!-- Theme color for Safari browser bars (light theme) -->
    <meta
      name="theme-color"
      content="#f4f4f4"
      media="(prefers-color-scheme: light)"
    />
    <!-- Theme color for Safari browser bars (dark theme) -->
    <meta
      name="theme-color"
      content="#1a1a1a"
      media="(prefers-color-scheme: dark)"
    />

    <title>
      {
        title.includes("Ágora")
          ? title
          : `${title} | Ágora - Academia de Matemáticas`
      }
    </title>

    <!-- SEO Meta Tags -->
    <meta name="description" content={description} />
    <meta
      name="keywords"
      content="academia matemáticas Cuenca, clases matemáticas ESO, Bachillerato, refuerzo escolar, matemáticas Cuenca"
    />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />

    <!-- Fonts preconnect -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />

    <!-- Favicon & Manifest -->
    <link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/favicon/apple-touch-icon.png"
    />
    <link rel="manifest" href="/favicon/site.webmanifest" />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/favicon/logo.png" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Ágora Academia" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- KaTeX -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css"
      integrity="sha384-n8MVd4RsNIU0tAv4ct0nTaAbDJwPJzDEaqSD1odI+WdtXRGWt2kTvGFasIQSqnWW"
      crossorigin="anonymous"
    />

    <!-- Structured Data (JSON-LD) -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        "name": "Ágora - Academia de Matemáticas",
        "image": "https://www.agoraacademy.es/favicon/logo.png",
        "@id": "https://www.agoraacademy.es",
        "url": "https://www.agoraacademy.es",
        "telephone": "+34649021173",
        "email": "info@agoraacademy.es",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Calle Fermín Caballero, 3, Planta 6, espacio Einstein",
          "addressLocality": "Cuenca",
          "postalCode": "16004",
          "addressCountry": "ES"
        },
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": 40.071,
          "longitude": -2.137
        },
        "openingHoursSpecification": {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
          "opens": "16:00",
          "closes": "20:00"
        },
        "description": "Academia especializada en matemáticas para E.S.O. y Bachillerato en Cuenca. Grupos reducidos y atención personalizada."
      }
    </script>
    <script
      is:inline
      src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js"
      integrity="sha384-XjKyOOlGwcjNTAIQHIWDoAqh6SBAVBQ9LDXQ8i61zp5ID0lCPWutQ98ELXJLz0RP"
      crossorigin="anonymous"></script>
    <script
      is:inline
      src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/auto-render.min.js"
      integrity="sha384-+VBxd3r6XgURycqtZ117nYw44OOcIax56Z4dCRWbxyPt0Koah1uHoK0o4+/RRE05"
      crossorigin="anonymous"></script>

    <script is:inline>
      const renderMath = () => {
        if (typeof renderMathInElement === "function") {
          renderMathInElement(document.body, {
            delimiters: [
              { left: "$$", right: "$$", display: true },
              { left: "$", right: "$", display: false },
              { left: "\\(", right: "\\)", display: false },
              { left: "\\[", right: "\\]", display: true },
            ],
            throwOnError: false,
          });
        }
      };

      document.addEventListener("astro:page-load", renderMath);

      const getTheme = () => {
        if (
          typeof localStorage !== "undefined" &&
          localStorage.getItem("theme")
        ) {
          return localStorage.getItem("theme");
        }
        return window.matchMedia("(prefers-color-scheme: dark)").matches
          ? "dark"
          : "light";
      };

      const setTheme = (theme) => {
        if (theme === "dark") {
          document.documentElement.setAttribute("data-theme", "dark");
        } else {
          document.documentElement.removeAttribute("data-theme");
        }
      };

      setTheme(getTheme());
      document.addEventListener("astro:after-swap", () => setTheme(getTheme()));
    </script>
  </head>

  <body>
    <a href="#main-content" class="skip-link">Saltar al contenido</a>
    <GlobalNav transition:persist />
    <Menu currentPage={currentPage} transition:persist />

    <main id="main-content" class="container">
      <slot />

      <Footer transition:persist />
    </main>

    <style is:global>
      @import "../styles/global.css";
    </style>

    <script>
      import "../scripts/animations.js";
    </script>
  </body>
</html>
