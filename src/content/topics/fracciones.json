{
    "title": "Operaciones con Fracciones",
    "description": "Guía completa sobre cómo realizar operaciones con fracciones: suma, resta, multiplicación, división y simplificación.",
    "sections": [
        {
            "title": "Suma y Resta",
            "items": [
                {
                    "title": "Mismo denominador",
                    "formula": "$\\frac{a}{c} \\pm \\frac{b}{c} = \\frac{a \\pm b}{c}$",
                    "example": "$\\frac{2}{7} + \\frac{3}{7} = \\frac{5}{7}$"
                },
                {
                    "title": "Distinto denominador",
                    "formula": "$\\frac{a}{b} \\pm \\frac{c}{d} = \\frac{a \\cdot d \\pm b \\cdot c}{b \\cdot d}$",
                    "example": "$\\frac{1}{2} + \\frac{1}{3} = \\frac{1 \\cdot 3 + 2 \\cdot 1}{2 \\cdot 3} = \\frac{5}{6}$",
                    "description": "Se suele utilizar el <strong>m.c.m.</strong> de los denominadores para simplificar los cálculos."
                }
            ]
        },
        {
            "title": "Multiplicación y División",
            "items": [
                {
                    "title": "Multiplicación",
                    "formula": "$\\frac{a}{b} \\cdot \\frac{c}{d} = \\frac{a \\cdot c}{b \\cdot d}$",
                    "example": "$\\frac{2}{3} \\cdot \\frac{4}{5} = \\frac{8}{15}$",
                    "description": "Se multiplica numerador por numerador y denominador por denominador."
                },
                {
                    "title": "División",
                    "formula": "$\\frac{a}{b} : \\frac{c}{d} = \\frac{a \\cdot d}{b \\cdot c}$",
                    "example": "$\\frac{3}{4} : \\frac{2}{5} = \\frac{3 \\cdot 5}{4 \\cdot 2} = \\frac{15}{8}$",
                    "description": "Se multiplica en cruz (numerador por denominador opuesto)."
                }
            ]
        },
        {
            "title": "Propiedades Adicionales",
            "items": [
                {
                    "title": "Fracción de una cantidad",
                    "formula": "$\\frac{a}{b} \\text{ de } C = \\frac{a \\cdot C}{b}$",
                    "example": "$\\frac{2}{3} \\text{ de } 15 = \\frac{2 \\cdot 15}{3} = 10$"
                },
                {
                    "title": "Inversa de una fracción",
                    "formula": "(\\frac{a}{b})^{-1} = \\frac{b}{a}",
                    "example": "(\\frac{3}{4})^{-1} = \\frac{4}{3}"
                }
            ]
        }
    ]
}