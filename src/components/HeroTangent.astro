---
// Interactive replacement for the static hero PNG: a real parabola f(x) = x²
// with a draggable point of tangency. The curve itself is drawn as a single
// exact quadratic Bézier (Bézier curves are affine-invariant, and a parabola
// segment IS a quadratic Bézier arc when the endpoints share x(t) linear in
// t), so no point-sampling or polyline is needed for a mathematically exact
// curve. All the geometry below is duplicated (not shared) with the client
// script in the <script> block: both sides are ~6 short formulas, and having
// two tiny independent copies is simpler than wiring a data hand-off for
// numbers that never change.

const VB = 340; // square viewBox, px
const PAD = 30;
const X_MIN = -2.4;
const X_MAX = 2.4;
const Y_MIN = -1;
const Y_MAX = 6.4;
const SCALE_X = (VB - 2 * PAD) / (X_MAX - X_MIN);
const SCALE_Y = (VB - 2 * PAD) / (Y_MAX - Y_MIN);
const TANGENT_HALF_LENGTH = 78;
const DEFAULT_X = 1.4;

const f = (x: number) => x * x;
const px = (x: number) => PAD + (x - X_MIN) * SCALE_X;
const py = (y: number) => VB - PAD - (y - Y_MIN) * SCALE_Y;

// Exact control point for the Bézier arc tracing y = x² from X_MIN to X_MAX,
// derived from B(0.5) = f((x0+x2)/2): yc = 2·f(xm) − 0.5·(f(x0)+f(x2)).
const xm = (X_MIN + X_MAX) / 2;
const yc = 2 * f(xm) - 0.5 * (f(X_MIN) + f(X_MAX));
const curvePath = `M ${px(X_MIN)} ${py(f(X_MIN))} Q ${px(xm)} ${py(yc)} ${px(X_MAX)} ${py(f(X_MAX))}`;

const tangentPoints = (a: number) => {
    const m = 2 * a;
    const dirX = SCALE_X;
    const dirY = -SCALE_Y * m;
    const len = Math.hypot(dirX, dirY);
    const ux = dirX / len;
    const uy = dirY / len;
    const cx = px(a);
    const cy = py(f(a));
    return {
        cx,
        cy,
        x1: cx - ux * TANGENT_HALF_LENGTH,
        y1: cy - uy * TANGENT_HALF_LENGTH,
        x2: cx + ux * TANGENT_HALF_LENGTH,
        y2: cy + uy * TANGENT_HALF_LENGTH,
    };
};

const t0 = tangentPoints(DEFAULT_X);
const axisY = py(0);
const axisX = px(0);
---

<div class="hero-tangent">
    <p class="sr-only">
        Gráfico interactivo de la parábola f(x) = x². Un punto deslizante
        recorre la curva y muestra la recta tangente y su pendiente en cada
        posición.
    </p>
    <svg viewBox={`0 0 ${VB} ${VB}`} class="tangent-svg">
        <line
            class="axis"
            aria-hidden="true"
            x1={px(X_MIN)}
            y1={axisY}
            x2={px(X_MAX)}
            y2={axisY}
        />
        <line
            class="axis"
            aria-hidden="true"
            x1={axisX}
            y1={py(Y_MIN)}
            x2={axisX}
            y2={py(Y_MAX)}
        />
        <path class="curve" aria-hidden="true" d={curvePath} fill="none" />
        <line
            class="tangent-line"
            aria-hidden="true"
            id="tangentLine"
            x1={t0.x1}
            y1={t0.y1}
            x2={t0.x2}
            y2={t0.y2}
        />
        <circle
            class="tangent-handle"
            id="tangentHandle"
            cx={t0.cx}
            cy={t0.cy}
            r="7"
            tabindex="0"
            role="slider"
            aria-label="Punto de tangencia. Arrastra o usa las flechas izquierda y derecha."
            aria-valuemin={-2.1}
            aria-valuemax={2.1}
            aria-valuenow={DEFAULT_X}
            aria-valuetext={`x = ${DEFAULT_X.toFixed(2)}, pendiente = ${(2 * DEFAULT_X).toFixed(2)}`}
        ></circle>
    </svg>
    <p class="tangent-caption">
        <span class="tangent-hint">Arrastra el punto</span>
        <span class="tangent-value" id="tangentValue">
            x = {DEFAULT_X.toFixed(2)}, pendiente = {(2 * DEFAULT_X).toFixed(2)}
        </span>
    </p>
</div>

<script>
    const VB = 340;
    const PAD = 30;
    const X_MIN = -2.4;
    const X_MAX = 2.4;
    const Y_MIN = -1;
    const Y_MAX = 6.4;
    const SCALE_X = (VB - 2 * PAD) / (X_MAX - X_MIN);
    const SCALE_Y = (VB - 2 * PAD) / (Y_MAX - Y_MIN);
    const TANGENT_HALF_LENGTH = 78;
    const A_MIN = -2.1;
    const A_MAX = 2.1;
    const A_DEFAULT = 1.4;
    const A_START = -2.0;

    const f = (x: number) => x * x;
    const px = (x: number) => PAD + (x - X_MIN) * SCALE_X;
    const py = (y: number) => VB - PAD - (y - Y_MIN) * SCALE_Y;

    const easeOutBack = (t: number) => {
        const c1 = 1.70158;
        const c3 = c1 + 1;
        return 1 + c3 * Math.pow(t - 1, 3) + c1 * Math.pow(t - 1, 2);
    };

    let dragging = false;
    let introFrame: number;

    function render(
        a: number,
        svg: SVGSVGElement,
        line: SVGLineElement,
        handle: SVGCircleElement,
        valueLabel: HTMLElement,
    ) {
        const m = 2 * a;
        const dirX = SCALE_X;
        const dirY = -SCALE_Y * m;
        const len = Math.hypot(dirX, dirY);
        const ux = dirX / len;
        const uy = dirY / len;
        const cx = px(a);
        const cy = py(f(a));

        line.setAttribute("x1", String(cx - ux * TANGENT_HALF_LENGTH));
        line.setAttribute("y1", String(cy - uy * TANGENT_HALF_LENGTH));
        line.setAttribute("x2", String(cx + ux * TANGENT_HALF_LENGTH));
        line.setAttribute("y2", String(cy + uy * TANGENT_HALF_LENGTH));
        handle.setAttribute("cx", String(cx));
        handle.setAttribute("cy", String(cy));
        handle.setAttribute("aria-valuenow", a.toFixed(2));
        handle.setAttribute(
            "aria-valuetext",
            `x = ${a.toFixed(2)}, pendiente = ${m.toFixed(2)}`,
        );
        valueLabel.textContent = `x = ${a.toFixed(2)}, pendiente = ${m.toFixed(2)}`;
    }

    function svgXToA(svg: SVGSVGElement, clientX: number) {
        const pt = svg.createSVGPoint();
        pt.x = clientX;
        pt.y = 0;
        const ctm = svg.getScreenCTM();
        if (!ctm) return A_DEFAULT;
        const svgPt = pt.matrixTransform(ctm.inverse());
        const a = X_MIN + (svgPt.x - PAD) / SCALE_X;
        return Math.min(A_MAX, Math.max(A_MIN, a));
    }

    function initHeroTangent() {
        const root = document.querySelector(".hero-tangent");
        const svg = root?.querySelector<SVGSVGElement>(".tangent-svg");
        const line = document.getElementById(
            "tangentLine",
        ) as SVGLineElement | null;
        const handle = document.getElementById(
            "tangentHandle",
        ) as SVGCircleElement | null;
        const valueLabel = document.getElementById("tangentValue");
        if (!root || !svg || !line || !handle || !valueLabel) return;

        cancelAnimationFrame(introFrame);

        const reduce = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
        ).matches;

        const onMove = (e: PointerEvent) => {
            if (!dragging) return;
            render(svgXToA(svg, e.clientX), svg, line, handle, valueLabel);
        };
        const onUp = () => {
            dragging = false;
            window.removeEventListener("pointermove", onMove);
            window.removeEventListener("pointerup", onUp);
        };
        const onDown = (e: PointerEvent) => {
            dragging = true;
            render(svgXToA(svg, e.clientX), svg, line, handle, valueLabel);
            window.addEventListener("pointermove", onMove);
            window.addEventListener("pointerup", onUp);
        };

        handle.removeEventListener("pointerdown", onDown as EventListener);
        handle.addEventListener("pointerdown", onDown as EventListener);

        const onKey = (e: KeyboardEvent) => {
            const current = Number(handle.getAttribute("aria-valuenow"));
            let next = current;
            if (e.key === "ArrowLeft") next = current - 0.1;
            else if (e.key === "ArrowRight") next = current + 0.1;
            else if (e.key === "Home") next = A_MIN;
            else if (e.key === "End") next = A_MAX;
            else return;
            e.preventDefault();
            render(
                Math.min(A_MAX, Math.max(A_MIN, next)),
                svg,
                line,
                handle,
                valueLabel,
            );
        };
        handle.removeEventListener("keydown", onKey as EventListener);
        handle.addEventListener("keydown", onKey as EventListener);

        if (reduce) {
            render(A_DEFAULT, svg, line, handle, valueLabel);
            return;
        }

        // Spring the point in from A_START to A_DEFAULT on entry, replacing
        // the generic fade-up .reveal this figure used to share with the
        // rest of the page, with a motion that performs the widget's own
        // subject matter instead of a generic slide.
        const duration = 900;
        const start = performance.now();
        const tick = (now: number) => {
            const t = Math.min(1, (now - start) / duration);
            const eased = easeOutBack(t);
            render(
                A_START + (A_DEFAULT - A_START) * eased,
                svg,
                line,
                handle,
                valueLabel,
            );
            if (t < 1) introFrame = requestAnimationFrame(tick);
        };
        introFrame = requestAnimationFrame(tick);
    }

    document.addEventListener("astro:page-load", initHeroTangent);
</script>

<style>
    .hero-tangent {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-xs);
    }

    .tangent-svg {
        display: block;
        width: 100%;
        height: auto;
        touch-action: none;
    }

    .axis {
        stroke: var(--text-muted);
        stroke-width: 1.5;
    }

    .curve {
        stroke: var(--accent);
        stroke-width: 3;
        stroke-linecap: round;
    }

    .tangent-line {
        stroke: var(--text-primary);
        stroke-width: 2;
        stroke-dasharray: 6 6;
    }

    .tangent-handle {
        fill: var(--accent);
        stroke: var(--border-color);
        stroke-width: 2;
        cursor: grab;
    }

    .tangent-handle:active {
        cursor: grabbing;
    }

    /* Drag/click focus shouldn't ring (the pointer already shows where you
       are); only a real keyboard focus gets the system's global ring. */
    .tangent-handle:focus {
        outline: none;
    }

    .tangent-handle:focus-visible {
        outline: 3px solid var(--accent);
        outline-offset: 3px;
    }

    .tangent-caption {
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: var(--spacing-xs);
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--text-muted);
    }

    .tangent-value {
        color: var(--accent-strong);
    }

    @media (prefers-reduced-motion: reduce) {
        .tangent-handle {
            cursor: pointer;
        }
    }
</style>
