---
import { slugify } from "../utils/slugify";
import { Icon } from "astro-icon/components";

interface Props {
    sections: { title: string }[];
}

const { sections } = Astro.props;
---

{
    sections.length > 1 && (
        <nav class="toc-nav" aria-label="Índice de contenidos">
            <details class="toc-container" id="tocDetails">
                <summary class="toc-header meta-label">
                    <span class="toc-title">Índice</span>
                    <span class="toc-count">{sections.length} secciones</span>
                    <Icon name="ph:caret-down" class="toc-caret" aria-hidden="true" />
                </summary>
                <ul class="toc-list" id="tocList">
                    {sections.map((section) => (
                        <li>
                            <a href={`#${slugify(section.title)}`} data-toc-link={slugify(section.title)}>
                                <Icon name="ph:arrow-right" class="toc-bullet" aria-hidden="true" />
                                <span class="toc-label">{section.title}</span>
                            </a>
                        </li>
                    ))}
                </ul>
            </details>
            {/* Open on wide screens before first paint; phones keep it closed so
                the first formula is not pushed below the fold. */}
            <script is:inline data-astro-rerun>
                (() => {
                    const toc = document.getElementById("tocDetails");
                    if (toc && window.matchMedia("(min-width: 768px)").matches) toc.open = true;
                })();
            </script>
        </nav>
    )
}

<script>
    function initTocScrollspy() {
        const tocLinks = document.querySelectorAll<HTMLAnchorElement>("#tocList a[data-toc-link]");
        if (tocLinks.length === 0) return;

        // Phones: jumping to a section closes the index again.
        const toc = document.getElementById("tocDetails") as HTMLDetailsElement | null;
        tocLinks.forEach((link) =>
            link.addEventListener("click", () => {
                if (toc && !window.matchMedia("(min-width: 768px)").matches) toc.open = false;
            }),
        );

        const sectionIds = Array.from(tocLinks).map((link) => link.dataset.tocLink).filter(Boolean) as string[];
        const sections: HTMLElement[] = [];

        sectionIds.forEach((id) => {
            const el = document.getElementById(id);
            if (el) sections.push(el);
        });

        if (sections.length === 0) return;

        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        const id = entry.target.id;
                        tocLinks.forEach((link) => {
                            const isActive = link.dataset.tocLink === id;
                            link.classList.toggle("active", isActive);
                        });
                    }
                });
            },
            {
                rootMargin: "-80px 0px -65% 0px",
                threshold: 0,
            }
        );

        sections.forEach((sec) => observer.observe(sec));
    }

    document.addEventListener("astro:page-load", initTocScrollspy);
</script>

<style>
    .toc-container {
        background: var(--bg-raised);
        border: var(--border-width) solid var(--border-color);
        padding: var(--spacing-md);
        margin-bottom: var(--spacing-lg);
        box-shadow: var(--shadow-offset) var(--shadow-offset) 0
            var(--shadow-color);
    }

    .toc-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--spacing-sm);
        min-height: 44px;
        margin: calc(var(--spacing-md) * -1);
        padding: 0 var(--spacing-md);
        color: var(--text-primary);
        cursor: pointer;
        list-style: none;
    }

    .toc-header::-webkit-details-marker {
        display: none;
    }

    .toc-count {
        white-space: nowrap;
        margin-left: auto;
        color: var(--text-muted);
    }

    .toc-header :global(.toc-caret) {
        width: 16px;
        height: 16px;
        flex-shrink: 0;
        transition: transform var(--transition);
    }

    .toc-container[open] .toc-header {
        margin-bottom: var(--spacing-sm);
        border-bottom: 2px solid var(--accent);
    }

    .toc-container[open] .toc-header :global(.toc-caret) {
        transform: rotate(180deg);
    }

    .toc-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
    }

    .toc-list a {
        text-decoration: none;
        color: var(--text-secondary);
        transition: all var(--transition);
        display: flex;
        align-items: center;
        gap: var(--spacing-xs);
        min-height: 44px;
        padding: 2px 4px;
        border-radius: var(--radius);
    }

    .toc-list a:hover {
        color: var(--text-primary);
        transform: translateX(4px);
    }

    .toc-list a.active {
        color: var(--text-primary);
        font-weight: 700;
        transform: translateX(4px);
    }

    .toc-list a.active :global(.toc-bullet) {
        transform: translateX(2px);
    }

    .toc-list :global(.toc-bullet) {
        width: 14px;
        height: 14px;
        flex-shrink: 0;
        color: var(--accent);
        transition: transform var(--transition);
    }

    @media (min-width: 768px) {
        .toc-list {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: 0 var(--spacing-sm);
        }
    }

    @media print {
        .toc-nav {
            display: none !important;
        }
    }
</style>
