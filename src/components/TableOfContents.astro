---
import { slugify } from "../utils/slugify";

interface Props {
    sections: { title: string }[];
}

const { sections } = Astro.props;
---

{
    sections.length > 1 && (
        <nav class="toc-container" aria-label="Índice de contenidos">
            <div class="toc-header">Índice de contenidos</div>
            <ul class="toc-list" id="tocList">
                {sections.map((section) => (
                    <li>
                        <a href={`#${slugify(section.title)}`} data-toc-link={slugify(section.title)}>
                            <span class="toc-bullet">→</span>
                            <span class="toc-label">{section.title}</span>
                        </a>
                    </li>
                ))}
            </ul>
        </nav>
    )
}

<script>
    function initTocScrollspy() {
        const tocLinks = document.querySelectorAll<HTMLAnchorElement>("#tocList a[data-toc-link]");
        if (tocLinks.length === 0) return;

        const sectionIds = Array.from(tocLinks).map((link) => link.dataset.tocLink).filter(Boolean) as string[];
        const sections: HTMLElement[] = [];

        sectionIds.forEach((id) => {
            const el = document.getElementById(id);
            if (el) sections.push(el);
        });

        if (sections.length === 0) return;

        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        const id = entry.target.id;
                        tocLinks.forEach((link) => {
                            const isActive = link.dataset.tocLink === id;
                            link.classList.toggle("active", isActive);
                        });
                    }
                });
            },
            {
                rootMargin: "-80px 0px -65% 0px",
                threshold: 0,
            }
        );

        sections.forEach((sec) => observer.observe(sec));
    }

    document.addEventListener("astro:page-load", initTocScrollspy);
</script>

<style>
    .toc-container {
        background: var(--bg-secondary);
        border: var(--border-width) solid var(--border-color);
        padding: var(--spacing-md);
        margin-bottom: var(--spacing-lg);
        box-shadow: var(--shadow-offset) var(--shadow-offset) 0
            var(--shadow-color);
    }

    .toc-header {
        font-family: var(--font-family);
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: var(--spacing-sm);
        color: var(--text-primary);
        border-bottom: 1px solid var(--border-color);
        padding-bottom: var(--spacing-xs);
    }

    .toc-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: var(--spacing-xs);
    }

    .toc-list a {
        text-decoration: none;
        color: var(--text-secondary);
        transition: all var(--transition);
        display: flex;
        align-items: center;
        gap: var(--spacing-xs);
        padding: 2px 4px;
        border-radius: var(--radius);
    }

    .toc-list a:hover {
        color: var(--text-primary);
        transform: translateX(4px);
    }

    .toc-list a.active {
        color: var(--text-primary);
        font-weight: 700;
        transform: translateX(4px);
    }

    .toc-list a.active .toc-bullet {
        transform: scale(1.3);
    }

    .toc-bullet {
        color: var(--accent);
        font-weight: bold;
        transition: transform var(--transition);
    }

    @media (min-width: 768px) {
        .toc-list {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
            gap: var(--spacing-sm);
        }
    }
</style>
