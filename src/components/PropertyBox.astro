---
import InfoBox from "./InfoBox.astro";

interface Props {
    title: string;
    formula?: string;
    example?: string;
    description?: string;
}

const { title, formula, example, description } = Astro.props;

import { renderMath } from "../utils/math";

const processedFormula = formula ? renderMath(formula) : undefined;
const processedExample = example ? renderMath(example) : undefined;
const processedDescription = description ? renderMath(description) : undefined;
const processedTitle = renderMath(title);
---

<InfoBox class="property-box">
    <h3 set:html={processedTitle} />

    {
        processedFormula && (
            <div class="formula-container">
                <span class="sr-only">Fórmula:</span>
                <div class="formula" set:html={processedFormula} />
            </div>
        )
    }

    {
        processedExample && (
            <div class="example-container">
                <p class="example-label">Ejemplo:</p>
                <div
                    class="formula example-formula"
                    set:html={processedExample}
                />
            </div>
        )
    }

    {
        processedDescription && (
            <div class="description" set:html={processedDescription} />
        )
    }
</InfoBox>

<style>
    .property-box h3 {
        padding-bottom: var(--spacing-xs);
        margin-bottom: var(--spacing-sm);
        border-bottom: 2px solid var(--border-color);
        display: inline-block;
    }

    .formula-container,
    .example-container {
        margin: var(--spacing-md) 0;
    }

    .formula {
        font-weight: 400;
        color: var(--text-primary);
        background: var(--bg-primary);
        padding: 20px;
        margin: var(--spacing-sm) 0;
        text-align: left;
        white-space: pre-wrap; /* allow wrapping by default */
        overflow-x: auto;
        max-width: 100%;
        border: 1px solid var(--border-color);
        border-radius: var(--radius);
        transition: background var(--transition);
        /* Mobile scroll smoothing */
        -webkit-overflow-scrolling: touch;
        scrollbar-width: thin;
        scrollbar-color: var(--border-color) transparent;
    }

    .formula::-webkit-scrollbar {
        height: 4px;
    }

    .formula::-webkit-scrollbar-thumb {
        background: var(--border-color);
        border-radius: var(--radius);
    }

    /* Dedicated formula container should remain nowrap to keep equations on one line if possible */
    .formula-container .formula {
        white-space: nowrap;
    }

    /* Example formula container should allow wrapping as it often contains descriptive text */
    .example-formula {
        white-space: normal;
        line-height: 1.6;
    }

    .example-label {
        font-weight: 700;
        font-size: var(--font-size-md);
        color: var(--text-muted);
        letter-spacing: 1px;
    }

    .description {
        margin-top: var(--spacing-md);
        font-size: var(--font-size-md);
        color: var(--text-tertiary);
        line-height: 1.6;
        word-break: break-word;
    }

    :global(.description img), :global(.example-formula img) {
        max-width: 100% !important;
        height: auto !important;
        display: block;
        margin: var(--spacing-sm) auto;
    }

    /* KaTeX overrides for formulas */
    :global(.formula .katex-display) {
        display: inline !important;
        margin: 0 !important;
    }

    :global(.formula .katex) {
        font-size: 1.2em;
    }
</style>
