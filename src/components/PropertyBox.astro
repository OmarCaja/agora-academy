---
import { KIND_LABELS, type Kind } from "../data/itemKinds";

interface Props {
    title: string;
    kind?: Kind;
    formula?: string;
    example?: string;
    description?: string;
}

const { title, kind, formula, example, description } = Astro.props;

import { renderMath } from "../utils/math";

const processedFormula = formula ? renderMath(formula) : undefined;
const processedExample = example ? renderMath(example) : undefined;
const processedDescription = description ? renderMath(description) : undefined;
const processedTitle = renderMath(title);
---

<div class:list={["info-box", "property-box", kind && `kind-${kind}`]}>
    {kind && <p class="kind-label meta-label">{KIND_LABELS[kind]}</p>}
    <h3 set:html={processedTitle} />

    {
        processedDescription && (
            <div class="description" set:html={processedDescription} />
        )
    }

    {
        processedFormula && (
            <div class="formula-container">
                <span class="sr-only">Fórmula:</span>
                <div class="formula" set:html={processedFormula} />
            </div>
        )
    }

    {
        processedExample && (
            <div class="example-container">
                <p class="example-label meta-label">Ejemplo:</p>
                <div
                    class="formula example-formula"
                    set:html={processedExample}
                />
            </div>
        )
    }
</div>

<style>
    .property-box h3 {
        padding-bottom: var(--spacing-xs);
        margin-bottom: var(--spacing-sm);
        border-bottom: 2px solid var(--border-color);
        display: inline-block;
    }

    .formula-container,
    .example-container {
        margin: var(--spacing-md) 0 0;
    }

    .formula {
        font-weight: 400;
        color: var(--text-primary);
        background: var(--bg-primary);
        padding: 20px;
        margin: var(--spacing-sm) 0;
        text-align: left;
        white-space: pre-wrap; /* allow wrapping by default */
        overflow-x: auto;
        max-width: 100%;
        border: 1px solid var(--border-color);
        border-radius: var(--radius);
        transition: background var(--transition);
        /* Mobile scroll smoothing */
        -webkit-overflow-scrolling: touch;
        scrollbar-width: thin;
        scrollbar-color: var(--border-color) transparent;
    }

    .formula::-webkit-scrollbar {
        height: 4px;
    }

    .formula::-webkit-scrollbar-thumb {
        background: var(--border-color);
        border-radius: var(--radius);
    }

    /* Dedicated formula container should remain nowrap to keep equations on one line if possible */
    .formula-container .formula {
        white-space: nowrap;
    }

    /* Example formula container should allow wrapping as it often contains descriptive text */
    .example-formula {
        white-space: normal;
        line-height: 1.7;
    }

    /* When an example wraps, each chunk of maths is an inline-block whose box is
       shorter than its fractions, so a denominator can land on the next line's
       numerator. A little vertical margin on each chunk keeps the lines apart. */
    :global(.example-formula .katex-base) {
        margin-block: 0.25em;
    }

    .example-label {
        color: var(--text-muted);
    }

    .kind-label {
        display: block;
        width: fit-content;
        margin: 0 0 var(--spacing-xs);
        padding: 2px 10px;
        border: var(--border-width) solid var(--border-color);
        color: var(--text-primary);
    }

    /* A definition is the one card the rest of the section builds on: inverted label, heavy left rule. */
    .kind-definicion {
        border-left-width: 10px;
    }

    .kind-definicion .kind-label {
        background: var(--accent);
        color: var(--on-accent);
    }

    .kind-teorema {
        border-left-width: 10px;
        border-left-style: double;
    }

    .description {
        margin-top: 0;
        font-size: var(--font-size-md);
        color: var(--text-tertiary);
        line-height: 1.6;
        word-break: break-word;
    }

    /* Inline formulas inside prose can render wider than the reading column; scroll rather than overflow it */
    :global(.description .katex) {
        display: inline-block;
        max-width: 100%;
        overflow-x: auto;
        vertical-align: middle;
    }

    :global(.description img), :global(.example-formula img) {
        max-width: 100% !important;
        height: auto !important;
        display: block;
        margin: var(--spacing-sm) auto;
    }

    /* KaTeX overrides for formulas */
    :global(.formula .katex-display) {
        display: inline !important;
        margin: 0 !important;
    }

    :global(.formula .katex) {
        font-size: 1.2em;
    }
</style>
