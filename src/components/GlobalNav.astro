---

<header class="global-nav">
    <div class="nav-content">
        <button
            class="nav-btn menu-btn"
            id="menuToggle"
            aria-label="Abrir menú de navegación"
        >
            <span class="menu-symbol">π</span>
        </button>

        <a href="/" class="nav-logo" aria-label="Agorá Academy">
            <svg
                class="nav-logo-svg"
                viewBox="0 0 200 200"
                xmlns="http://www.w3.org/2000/svg"
            >
                <g
                    transform="matrix(12.166336633663366,0,0,12.166336633663366,8.084616048088165,186.50202995621333)"
                >
                    <path
                        d="M5.64-14.22L7.47-14.22L7.51-14.18L7.55-14.22L9.38-14.22L14.95 0L0.16 0L5.64-14.22ZM7.52-10.30L4.74-2.64L10.36-2.64L7.52-10.30Z"
                        fill="currentColor"></path>
                </g>
            </svg>
        </a>

        <button
            class="nav-btn theme-btn"
            id="themeToggle"
            aria-label="Cambiar entre tema claro y oscuro"
        >
            <span id="themeIcon" aria-hidden="true">🌑</span>
            <span class="sr-only" id="themeText">Cambiar a tema oscuro</span>
        </button>
    </div>
</header>
<script>
    import "../scripts/theme.js";
    // We don't import menu.js here because Menu.astro handles it (and the overlay)
    // But we need to make sure Menu.astro is present in the layout.
</script>

<style>
    .global-nav {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        height: 48px;
        z-index: 1001;

        /* Light Theme (Default) */
        background-color: rgba(255, 255, 255, 0.8);
        border-bottom: 1px solid rgba(0, 0, 0, 0.1);

        backdrop-filter: saturate(180%) blur(20px);
        -webkit-backdrop-filter: saturate(180%) blur(20px);
        transition:
            background-color 0.3s ease,
            border-color 0.3s ease;
    }

    /* Dark Theme Override */
    :global([data-theme="dark"]) .global-nav {
        background-color: rgba(22, 22, 24, 0.8);
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .nav-content {
        max-width: 1000px;
        margin: 0 auto;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0 20px;
    }

    .nav-btn {
        background: transparent;
        border: none;
        cursor: pointer;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 100%;
        transition: color 0.3s ease;
        -webkit-tap-highlight-color: transparent;
        outline: none;
        opacity: 1 !important;

        /* Light Theme Text */
        color: #1d1d1f;
    }

    /* Dark Theme Text Overlay */
    :global([data-theme="dark"]) .nav-btn {
        color: #f5f5f7;
    }

    .menu-symbol,
    #themeIcon {
        font-size: 1.2rem;
        line-height: 1;
    }

    .menu-symbol {
        font-size: 1.5rem;
    }

    .nav-logo {
        display: flex;
        align-items: center;
        justify-content: center;
        height: 100%;
        transition: color 0.3s ease;
        -webkit-tap-highlight-color: transparent;
        outline: none;
        opacity: 1 !important;
        /* Light Theme Text (matches nav-btn) */
        color: #1d1d1f;
    }

    :global([data-theme="dark"]) .nav-logo {
        color: #f5f5f7;
    }

    .nav-logo-svg {
        height: 20px;
        width: auto;
        display: block;
    }

    /* Adjust body padding to prevent content hiding behind fixed header */
    /* This needs to be global or applied in layout. */

    @media (max-width: 768px) {
        .nav-content {
            padding: 0 16px;
        }
    }
</style>
