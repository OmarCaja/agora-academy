---
import { Icon } from "astro-icon/components";
import { SITE_NAME } from "../data/site";
---

<header class="global-nav">
    <div class="nav-content">
        <a href="/" class="nav-logo" aria-label={SITE_NAME}>
            <svg
                class="nav-logo-svg"
                viewBox="0 0 200 200"
                xmlns="http://www.w3.org/2000/svg"
            >
                <g
                    transform="matrix(12.166336633663366,0,0,12.166336633663366,8.084616048088165,186.50202995621333)"
                >
                    <path
                        d="M5.64-14.22L7.47-14.22L7.51-14.18L7.55-14.22L9.38-14.22L14.95 0L0.16 0L5.64-14.22ZM7.52-10.30L4.74-2.64L10.36-2.64L7.52-10.30Z"
                        fill="currentColor"></path>
                </g>
            </svg>
        </a>

        <nav class="nav-links" aria-label="Secciones principales">
            <a href="/theory/" data-nav-section="/theory">Teoría</a>
            <a href="/exercises/" data-nav-section="/exercises">Ejercicios</a>
            <a href="/books/" data-nav-section="/books">Libros PDF</a>
            <a href="/#contacto">Contacto</a>
        </nav>

        <button
            class="nav-btn theme-btn"
            id="themeToggle"
            aria-label="Cambiar entre tema claro y oscuro"
        >
            <span id="themeIcon" class="theme-icon" aria-hidden="true">
                <Icon name="ph:sun" class="icon-sun" />
                <Icon name="ph:moon" class="icon-moon" />
            </span>
            <span class="sr-only" id="themeText">Cambiar a tema oscuro</span>
        </button>

        <button
            class="nav-btn menu-btn"
            id="menuToggle"
            aria-label="Menú de navegación"
            aria-expanded="false"
        >
            <span class="accordion-icon"></span>
        </button>
    </div>
</header>
<script>
    import "../scripts/theme.js";
    // We don't import menu.js here because Menu.astro handles it (and the overlay)
    // But we need to make sure Menu.astro is present in the layout.

    // The bar is rendered with `transition:persist`, so the current section is
    // marked from the URL on every navigation instead of at build time.
    const markCurrentSection = () => {
        const path = window.location.pathname;
        document.querySelectorAll<HTMLAnchorElement>(".nav-links a[data-nav-section]").forEach((link) => {
            if (path.startsWith(link.dataset.navSection!)) link.setAttribute("aria-current", "true");
            else link.removeAttribute("aria-current");
        });
    };
    document.addEventListener("astro:page-load", markCurrentSection);
</script>

<style>
    .global-nav {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        height: 48px;
        z-index: 1001;

        background-color: var(--nav-bg);
        border-bottom: 1px solid var(--nav-border);

        /* backdrop-filter is declared in global.css to avoid LightningCSS stripping it */
        transition:
            background-color 0.3s ease,
            border-color 0.3s ease;
    }

    .nav-content {
        max-width: var(--shell);
        margin: 0 auto;
        height: 100%;
        /* Phones: theme toggle, centred logo, menu trigger. The DOM order is the
           desktop reading order (logo, links, theme, menu). */
        display: grid;
        grid-template-columns: 1fr auto 1fr;
        align-items: center;
        padding: 0 var(--spacing-xs);
    }

    .theme-btn {
        grid-column: 1;
        grid-row: 1;
        justify-self: start;
    }

    .nav-logo {
        grid-column: 2;
        grid-row: 1;
    }

    .menu-btn {
        grid-column: 3;
        grid-row: 1;
        justify-self: end;
    }

    .nav-links {
        display: none;
    }

    .nav-links a {
        display: inline-flex;
        align-items: center;
        height: 100%;
        padding: 0 12px;
        font-weight: 700;
        font-size: var(--font-size-sm);
        color: var(--text-secondary);
        text-decoration: none;
        white-space: nowrap;
        transition: color var(--transition), box-shadow var(--transition);
    }

    .nav-links a:hover {
        color: var(--text-primary);
        box-shadow: inset 0 -2px 0 var(--rule-color);
    }

    .nav-links a[aria-current] {
        color: var(--text-primary);
        box-shadow: inset 0 -2px 0 var(--accent);
    }

    @media (min-width: 900px) {
        .nav-content {
            display: flex;
            gap: var(--spacing-xs);
        }

        .nav-links {
            display: flex;
            height: 100%;
            margin-left: var(--spacing-sm);
        }

        .theme-btn {
            margin-left: auto;
        }
    }

    .nav-btn {
        background: transparent;
        border: none;
        cursor: pointer;
        padding: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        /* 44px minimum touch target */
        min-width: 44px;
        height: 100%;
        transition: color 0.3s ease;
        -webkit-tap-highlight-color: transparent;
        opacity: 1;

        color: var(--text-primary);
    }

    .accordion-icon {
        width: 14px;
        height: 14px;
        position: relative;
        transition: transform 0.4s var(--ease);
        opacity: 0.8;
    }

    .accordion-icon::before,
    .accordion-icon::after {
        content: "";
        position: absolute;
        background: currentColor;
        transition: transform 0.4s var(--ease);
    }

    /* Horizontal line */
    .accordion-icon::before {
        width: 14px;
        height: 2px;
        top: 6px;
        left: 0;
    }

    /* Vertical line */
    .accordion-icon::after {
        width: 2px;
        height: 14px;
        top: 0;
        left: 6px;
    }

    .menu-btn.active .accordion-icon {
        transform: rotate(45deg);
    }

    .theme-icon {
        display: flex;
        width: 19px;
        height: 19px;
    }

    .theme-icon :global(.icon-sun),
    .theme-icon :global(.icon-moon) {
        width: 100%;
        height: 100%;
    }

    .theme-icon :global(.icon-sun) {
        display: none;
    }

    :global([data-theme="dark"]) .theme-icon :global(.icon-sun) {
        display: block;
    }

    :global([data-theme="dark"]) .theme-icon :global(.icon-moon) {
        display: none;
    }

    .nav-logo {
        display: flex;
        align-items: center;
        justify-content: center;
        min-width: 44px;
        height: 100%;
        transition: color 0.3s ease;
        -webkit-tap-highlight-color: transparent;
        opacity: 1;
        color: var(--text-primary);
    }

    .nav-logo-svg {
        height: 20px;
        width: auto;
        display: block;
    }
</style>
