---
import { Icon } from "astro-icon/components";
import type { PdfLink } from "../utils/discoverExercises";

interface Props {
    pdfs: PdfLink[];
}

const { pdfs } = Astro.props;
---

<ul class="pdf-list">
    {pdfs.map((pdf) => (
        <li data-search-item data-search-text={pdf.name}>
            <a href={pdf.url} target="_blank" rel="noopener noreferrer" class="pdf-link">
                <div class="pdf-icon-wrapper">
                    <Icon name="ph:file-pdf" class="pdf-icon" aria-hidden="true" />
                </div>
                <span class="pdf-text">{pdf.name}</span>
                <Icon name="ph:arrow-right" class="arrow" aria-hidden="true" />
            </a>
        </li>
    ))}
</ul>

<style>
    .pdf-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: var(--spacing-sm);
    }

    .pdf-link {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-sm);
        height: 100%;
        text-decoration: none;
        color: var(--text-primary);
        font-weight: 700;
        transition: all var(--transition);
        padding: var(--spacing-md);
        border: var(--border-width) solid var(--border-color);
        border-radius: var(--radius);
        background: var(--bg-secondary);
        box-shadow: var(--shadow-offset) var(--shadow-offset) 0 var(--shadow-color);
    }

    .pdf-link:hover {
        background: var(--bg-primary);
        border-color: var(--accent);
        transform: translate(-3px, -3px);
        box-shadow: 6px 6px 0 var(--shadow-color);
    }

    .pdf-icon-wrapper {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        color: var(--on-accent);
        transition: transform var(--transition);
        background: var(--accent);
        border-radius: var(--radius);
        border: 1px solid var(--accent);
    }

    :global(.pdf-icon) {
        width: 21px;
        height: 21px;
    }

    .pdf-link:hover .pdf-icon-wrapper {
        transform: scale(1.08);
    }

    .pdf-text {
        flex: 1;
        font-size: var(--step-1);
        line-height: 1.35;
    }

    :global(.arrow) {
        align-self: flex-end;
        width: 18px;
        height: 18px;
        opacity: 0.55;
        color: var(--accent);
        transition: opacity var(--transition), transform var(--transition);
    }

    .pdf-link:hover :global(.arrow) {
        opacity: 1;
        transform: translateX(5px);
    }
</style>
