---
import { Icon } from "astro-icon/components";
import type { PdfLink } from "../utils/discoverExercises";

interface Props {
    pdfs: PdfLink[];
}

const { pdfs } = Astro.props;

// Outside the items on purpose: the search also matches on an item's textContent.
// Derived from the first PDF's URL: unique per list on a page and identical on every build.
const hintId = `pdf-hint${(pdfs[0]?.url ?? "").replace(/\.pdf$/i, "").replace(/[^a-z0-9]+/gi, "-")}`;
---

<p id={hintId} hidden>PDF, se abre en una pestaña nueva</p>
<ul class="pdf-list">
    {pdfs.map((pdf) => (
        <li data-search-item data-search-text={pdf.name}>
            <a href={pdf.url} target="_blank" rel="noopener noreferrer" class="pdf-link" aria-describedby={hintId}>
                <div class="pdf-icon-wrapper">
                    <Icon name="ph:file-pdf" class="pdf-icon" aria-hidden="true" />
                </div>
                <span class="pdf-text">{pdf.name}</span>
                {pdf.detail && <span class="pdf-detail">{pdf.detail}</span>}
                <Icon name="ph:arrow-right" class="arrow" aria-hidden="true" />
            </a>
        </li>
    ))}
</ul>

<style>
    .pdf-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: var(--spacing-sm);
    }

    .pdf-link {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-sm);
        height: 100%;
        text-decoration: none;
        color: var(--text-primary);
        font-weight: 700;
        transition: all var(--transition);
        padding: var(--spacing-md);
        border: var(--border-width) solid var(--border-color);
        border-radius: var(--radius);
        background: var(--bg-secondary);
        box-shadow: var(--shadow-offset) var(--shadow-offset) 0 var(--shadow-color);
    }

    .pdf-link:hover {
        background: var(--bg-primary);
        border-color: var(--accent);
        transform: translate(-3px, -3px);
        box-shadow: 6px 6px 0 var(--shadow-color);
    }

    .pdf-icon-wrapper {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        color: var(--on-accent);
        transition: transform var(--transition);
        background: var(--accent);
        border-radius: var(--radius);
        border: 1px solid var(--accent);
    }

    :global(.pdf-icon) {
        width: 21px;
        height: 21px;
    }

    .pdf-link:hover .pdf-icon-wrapper {
        transform: scale(1.08);
    }

    .pdf-text {
        flex: 1;
        font-size: var(--step-1);
        line-height: 1.35;
    }

    .pdf-detail {
        font-size: var(--font-size-sm);
        font-weight: 400;
        line-height: 1.5;
        color: var(--text-muted);
    }

    :global(.arrow) {
        align-self: flex-end;
        width: 18px;
        height: 18px;
        opacity: 0.55;
        color: var(--accent);
        transition: opacity var(--transition), transform var(--transition);
    }

    .pdf-link:hover :global(.arrow) {
        opacity: 1;
        transform: translateX(5px);
    }

    /* One column on phones: a row per PDF keeps a long list scannable. */
    @media (max-width: 519px) {
        .pdf-list {
            grid-template-columns: 1fr;
            gap: var(--spacing-xs);
        }

        .pdf-link {
            display: grid;
            grid-template-columns: auto 1fr auto;
            align-items: center;
            column-gap: var(--spacing-sm);
            row-gap: 2px;
            padding: 12px var(--spacing-sm);
            box-shadow: 3px 3px 0 var(--shadow-color);
        }

        .pdf-icon-wrapper {
            grid-row: 1 / span 2;
            align-self: start;
        }

        .pdf-text {
            grid-column: 2;
        }

        .pdf-text:nth-last-child(2) {
            grid-row: 1 / span 2;
        }

        .pdf-detail {
            grid-column: 2;
            grid-row: 2;
        }

        .pdf-link :global(.arrow) {
            grid-column: 3;
            grid-row: 1 / span 2;
            align-self: center;
        }
    }
</style>
