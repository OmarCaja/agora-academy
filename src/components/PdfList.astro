---
import { Icon } from "astro-icon/components";
import type { PdfLink } from "../utils/discoverExercises";

interface Props {
    pdfs: PdfLink[];
}

const { pdfs } = Astro.props;

// Outside the items on purpose: the search also matches on an item's textContent.
// Derived from the first PDF's URL: unique per list on a page and identical on every build.
const hintId = `pdf-hint${(pdfs[0]?.url ?? "").replace(/\.pdf$/i, "").replace(/[^a-z0-9]+/gi, "-")}`;
---

<p id={hintId} hidden>PDF, se abre en una pestaña nueva</p>
<ul class="pdf-list">
    {pdfs.map((pdf) => (
        <li data-search-item data-search-text={pdf.name}>
            <a href={pdf.url} target="_blank" rel="noopener noreferrer" class="pdf-link" aria-describedby={hintId}>
                <div class="pdf-icon-wrapper">
                    <Icon name="ph:file-pdf" class="pdf-icon" aria-hidden="true" />
                </div>
                <span class="pdf-text">{pdf.name}</span>
                {pdf.detail && <span class="pdf-detail">{pdf.detail}</span>}
                <Icon name="ph:arrow-right" class="arrow" aria-hidden="true" />
            </a>
        </li>
    ))}
</ul>

<style>
    /* A row per PDF at every width: icon, name, optional detail, arrow. Two
       columns once there is room, so a topic with seven sheets stays compact. */
    .pdf-list {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        grid-template-columns: 1fr;
        gap: var(--spacing-xs);
    }

    @media (min-width: 640px) {
        .pdf-list {
            grid-template-columns: repeat(2, 1fr);
            gap: var(--spacing-sm);
        }
    }

    .pdf-link {
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: center;
        column-gap: var(--spacing-sm);
        row-gap: 2px;
        height: 100%;
        min-height: 64px;
        padding: 12px var(--spacing-sm);
        text-decoration: none;
        color: var(--text-primary);
        font-weight: 700;
        border: var(--border-width) solid var(--border-color);
        border-radius: var(--radius);
        background: var(--bg-secondary);
        box-shadow: 3px 3px 0 var(--shadow-color);
        transition:
            transform var(--transition),
            box-shadow var(--transition),
            background var(--transition);
    }

    .pdf-link:hover {
        transform: translate(-2px, -2px);
        box-shadow: 5px 5px 0 var(--shadow-color);
    }

    .pdf-link:active {
        transform: translate(1px, 1px);
        box-shadow: 1px 1px 0 var(--shadow-color);
    }

    .pdf-icon-wrapper {
        grid-row: 1 / span 2;
        align-self: start;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        color: var(--on-accent);
        background: var(--accent);
        border-radius: var(--radius);
    }

    :global(.pdf-icon) {
        width: 20px;
        height: 20px;
    }

    .pdf-text {
        grid-column: 2;
        font-size: var(--step-0);
        line-height: 1.35;
    }

    /* No detail line: the name is centred against the icon. */
    .pdf-text:nth-last-child(2) {
        grid-row: 1 / span 2;
    }

    .pdf-detail {
        grid-column: 2;
        grid-row: 2;
        font-size: var(--font-size-sm);
        font-weight: 400;
        line-height: 1.5;
        color: var(--text-muted);
    }

    .pdf-link :global(.arrow) {
        grid-column: 3;
        grid-row: 1 / span 2;
        align-self: center;
        width: 18px;
        height: 18px;
        color: var(--accent);
        transition: transform var(--transition);
    }

    .pdf-link:hover :global(.arrow) {
        transform: translateX(4px);
    }
</style>
