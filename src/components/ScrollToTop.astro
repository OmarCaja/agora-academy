---
import { Icon } from "astro-icon/components";
---

{/* Sentinel sits ~400px down the document. Once it leaves the viewport the
    reader has scrolled far enough for the button to be useful. This replaces a
    window "scroll" listener (Section 5.D hard ban). */}
<span id="scrollSentinel" aria-hidden="true"></span>

<button
    id="scrollToTopBtn"
    class="scroll-to-top"
    aria-label="Volver arriba"
    title="Volver arriba"
>
    <Icon name="ph:arrow-up-bold" class="scroll-icon" aria-hidden="true" />
</button>

<script>
    // The button and sentinel are transition:persist, so the observer is kept
    // at module scope and rebuilt only when the sentinel node is replaced.
    let observer: IntersectionObserver | null = null;
    let watched: Element | null = null;

    const scrollToTop = () => {
        const reduce = window.matchMedia(
            "(prefers-reduced-motion: reduce)",
        ).matches;
        window.scrollTo({ top: 0, behavior: reduce ? "auto" : "smooth" });
    };

    function initScrollToTop() {
        const btn = document.getElementById("scrollToTopBtn");
        const sentinel = document.getElementById("scrollSentinel");
        if (!btn || !sentinel) return;

        btn.removeEventListener("click", scrollToTop);
        btn.addEventListener("click", scrollToTop);

        if (watched === sentinel && observer) return;

        observer?.disconnect();
        observer = new IntersectionObserver(
            ([entry]) => {
                btn.classList.toggle("visible", !entry.isIntersecting);
            },
            { threshold: 0 },
        );
        observer.observe(sentinel);
        watched = sentinel;
    }

    document.addEventListener("astro:page-load", initScrollToTop);
</script>

<style>
    /* Kept as a rendered (opacity 0) box rather than visibility:hidden, so it
       is unambiguously an IntersectionObserver target across engines. */
    #scrollSentinel {
        position: absolute;
        top: 400px;
        left: 0;
        width: 1px;
        height: 1px;
        opacity: 0;
        pointer-events: none;
    }

    .scroll-to-top {
        position: fixed;
        bottom: 24px;
        right: 24px;
        width: 46px;
        height: 46px;
        background: var(--bg-raised);
        color: var(--text-primary);
        border: var(--border-width) solid var(--border-color);
        border-radius: var(--radius);
        box-shadow: 3px 3px 0 var(--shadow-color);
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        z-index: 990;
        opacity: 0;
        visibility: hidden;
        transform: translateY(12px);
        transition:
            opacity var(--transition),
            visibility var(--transition),
            transform var(--transition),
            background var(--transition),
            color var(--transition),
            box-shadow var(--transition);
        -webkit-tap-highlight-color: transparent;
    }

    .scroll-to-top.visible {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
    }

    .scroll-to-top:hover {
        background: var(--accent);
        color: var(--on-accent);
        border-color: var(--accent);
        transform: translateY(-2px);
        box-shadow: 5px 5px 0 var(--shadow-color);
    }

    .scroll-to-top:active {
        transform: translate(2px, 2px);
        box-shadow: 1px 1px 0 var(--shadow-color);
    }

    .scroll-icon {
        width: 18px;
        height: 18px;
    }

    @media print {
        .scroll-to-top {
            display: none !important;
        }
    }
</style>
