---
import { Icon } from "astro-icon/components";

// Grid of internal navigation cards (theory and exercise indexes). PdfList is
// the counterpart for PDF downloads, which open in a new tab.
interface Props {
    items: { title: string; href: string; detail?: string; meta?: string }[];
}

const { items } = Astro.props;
---

<ul class="link-cards">
    {items.map((item) => (
        <li data-search-item data-search-text={item.title}>
            <a href={item.href} class="link-card">
                <span class="link-card-title">{item.title}</span>
                {item.detail && <span class="link-card-detail" set:html={item.detail} />}
                <span class="link-card-foot">
                    {item.meta && <span class="meta-label">{item.meta}</span>}
                    <Icon name="ph:arrow-right" class="link-card-arrow" aria-hidden="true" />
                </span>
            </a>
        </li>
    ))}
</ul>

<style>
    .link-cards {
        list-style: none;
        padding: 0;
        margin: 0;
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
        gap: var(--spacing-sm);
    }

    .link-card {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-xs);
        height: 100%;
        padding: var(--spacing-md);
        text-decoration: none;
        color: var(--text-primary);
        background: var(--bg-secondary);
        border: var(--border-width) solid var(--border-color);
        border-radius: var(--radius);
        box-shadow: 3px 3px 0 var(--shadow-color);
        transition:
            transform var(--transition),
            box-shadow var(--transition),
            background var(--transition);
    }

    .link-card:hover {
        transform: translate(-3px, -3px);
        box-shadow: 6px 6px 0 var(--shadow-color);
    }

    .link-card:active {
        transform: translate(1px, 1px);
        box-shadow: 1px 1px 0 var(--shadow-color);
    }

    .link-card-title {
        font-size: var(--step-1);
        font-weight: 700;
        line-height: 1.3;
    }

    .link-card-detail {
        font-size: var(--font-size-sm);
        line-height: 1.5;
        color: var(--text-muted);
        /* Keep cards scannable: the full description is on the page itself. */
        display: -webkit-box;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 4;
        line-clamp: 4;
        overflow: hidden;
    }

    .link-card-foot {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: var(--spacing-xs);
        margin-top: auto;
        padding-top: var(--spacing-xs);
        color: var(--text-muted);
    }

    .link-card-foot :global(.link-card-arrow) {
        width: 18px;
        height: 18px;
        margin-left: auto;
        color: var(--accent);
        transition: transform var(--transition);
    }

    .link-card:hover :global(.link-card-arrow) {
        transform: translateX(5px);
    }
</style>
