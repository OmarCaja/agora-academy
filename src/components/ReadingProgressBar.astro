<div class="progress-container">
    <div class="progress-bar" id="progressBar"></div>
</div>

<script>
    const updateProgressBar = () => {
        const progressBar = document.getElementById("progressBar");
        if (!progressBar) return;

        const winScroll =
            document.body.scrollTop || document.documentElement.scrollTop;
        const height =
            document.documentElement.scrollHeight -
            document.documentElement.clientHeight;
        // A page that doesn't scroll has height 0; without this the width would
        // be set to "NaN%" (ignored) and the persisted bar would keep the
        // previous page's fill.
        const scrolled = height > 0 ? (winScroll / height) * 100 : 0;
        progressBar.style.width = scrolled + "%";
    };

    window.addEventListener("scroll", updateProgressBar);
    document.addEventListener("astro:page-load", updateProgressBar);
</script>

<style>
    .progress-container {
        position: fixed;
        top: 48px; /* Height of GlobalNav */
        left: 0;
        width: 100%;
        height: 4px;
        background: transparent;
        z-index: 1000;
    }

    .progress-bar {
        height: 100%;
        background: var(--accent);
        width: 0%;
        transition: width 0.1s ease;
    }
</style>
