---
interface Props {
    currentPage?: string;
}

const { currentPage } = Astro.props;
---

<!-- Menu Overlay -->
<div class="menu-overlay" id="menuOverlay">
    <nav class="menu-nav">
        <div class="menu-group">
            <a
                href="/"
                data-astro-prefetch
                data-close-menu
                class:list={[
                    "menu-group-title",
                    "menu-link",
                    "nav-home",
                    { active: currentPage === "index" },
                ]}
            >
                Inicio
            </a>
            <a
                href="/#contacto"
                data-astro-prefetch
                data-close-menu
                class:list={["menu-item", "menu-subitem", "nav-contacto"]}
            >
                Contacto
            </a>
        </div>

        <div
            class:list={[
                "menu-group accordion",
                {
                    active: [
                        "jerarquia",
                        "propiedades-operaciones",
                        "divisibilidad",
                        "fracciones",
                    ].includes(currentPage || ""),
                },
            ]}
            data-accordion
        >
            <button class="menu-group-title accordion-trigger">
                Aritmética
                <span class="accordion-icon"></span>
            </button>
            <div class="accordion-content">
                <a
                    href="/jerarquia"
                    data-astro-prefetch
                    class:list={[
                        "menu-item",
                        "menu-subitem",
                        { active: currentPage === "jerarquia" },
                    ]}
                    aria-current={currentPage === "jerarquia"
                        ? "page"
                        : undefined}
                >
                    Jerarquía de las operaciones
                </a>
                <a
                    href="/propiedades-operaciones"
                    data-astro-prefetch
                    class:list={[
                        "menu-item",
                        "menu-subitem",
                        { active: currentPage === "propiedades-operaciones" },
                    ]}
                    aria-current={currentPage === "propiedades-operaciones"
                        ? "page"
                        : undefined}
                >
                    Propiedades de las operaciones
                </a>
                <a
                    href="/divisibilidad"
                    data-astro-prefetch
                    class:list={[
                        "menu-item",
                        "menu-subitem",
                        { active: currentPage === "divisibilidad" },
                    ]}
                    aria-current={currentPage === "divisibilidad"
                        ? "page"
                        : undefined}
                >
                    Factorización de números
                </a>
                <a
                    href="/fracciones"
                    data-astro-prefetch
                    class:list={[
                        "menu-item",
                        "menu-subitem",
                        { active: currentPage === "fracciones" },
                    ]}
                    aria-current={currentPage === "fracciones"
                        ? "page"
                        : undefined}
                >
                    Operaciones con fracciones
                </a>
            </div>
        </div>

        <div
            class:list={[
                "menu-group accordion",
                { active: currentPage === "identidades-notables" },
            ]}
            data-accordion
        >
            <button class="menu-group-title accordion-trigger">
                Álgebra
                <span class="accordion-icon"></span>
            </button>
            <div class="accordion-content">
                <a
                    href="/identidades-notables"
                    data-astro-prefetch
                    class:list={[
                        "menu-item",
                        "menu-subitem",
                        { active: currentPage === "identidades-notables" },
                    ]}
                    aria-current={currentPage === "identidades-notables"
                        ? "page"
                        : undefined}
                >
                    Identidades notables
                </a>
            </div>
        </div>

        <div
            class:list={[
                "menu-group accordion",
                {
                    active: ["potencias", "raices", "logaritmos"].includes(
                        currentPage || "",
                    ),
                },
            ]}
            data-accordion
        >
            <button class="menu-group-title accordion-trigger">
                Potencias y logaritmos
                <span class="accordion-icon"></span>
            </button>
            <div class="accordion-content">
                <a
                    href="/potencias"
                    data-astro-prefetch
                    class:list={[
                        "menu-item",
                        "menu-subitem",
                        { active: currentPage === "potencias" },
                    ]}
                    aria-current={currentPage === "potencias"
                        ? "page"
                        : undefined}
                >
                    Propiedades de las potencias
                </a>
                <a
                    href="/raices"
                    data-astro-prefetch
                    class:list={[
                        "menu-item",
                        "menu-subitem",
                        { active: currentPage === "raices" },
                    ]}
                    aria-current={currentPage === "raices" ? "page" : undefined}
                >
                    Propiedades de las raíces
                </a>
                <a
                    href="/logaritmos"
                    data-astro-prefetch
                    class:list={[
                        "menu-item",
                        "menu-subitem",
                        { active: currentPage === "logaritmos" },
                    ]}
                    aria-current={currentPage === "logaritmos"
                        ? "page"
                        : undefined}
                >
                    Propiedades de los logaritmos
                </a>
            </div>
        </div>
    </nav>
</div>

<script>
    import "../scripts/menu.js";
</script>

<style>
    /* ===== MENU OVERLAY ===== */
    .menu-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        width: 100%;
        /* Use dvh for dynamic viewport height support in modern Safari */
        height: 100vh;
        height: 100dvh;
        background: var(--bg-primary);
        z-index: 1000;
        display: flex;
        align-items: flex-start;
        justify-content: center;
        opacity: 0;
        pointer-events: none;
        transition: opacity var(--transition);
        padding-top: 40px;
        overflow-y: auto;
        overscroll-behavior: contain;
        -webkit-overflow-scrolling: touch;
    }

    @media (min-width: 768px) {
        .menu-overlay {
            padding-top: 80px;
        }
    }

    :global(.menu-overlay.active) {
        opacity: 1;
        pointer-events: all;
    }

    .menu-nav {
        display: flex;
        flex-direction: column;
        gap: 5px;
        padding: var(--spacing-lg);
        padding-bottom: calc(30px + env(safe-area-inset-bottom));
        max-width: 500px;
        width: 100%;
    }

    .menu-item {
        font-size: 1.125rem;
        color: var(--text-muted);
        text-decoration: none;
        padding: 12px 20px;
        border-left: 3px solid transparent;
        transition: all var(--transition);
        display: block;
        white-space: normal;
        line-height: 1.4;
    }

    .menu-item:hover {
        color: var(--text-primary);
        border-left-color: var(--border-color);
    }

    .menu-item.active {
        color: var(--text-primary);
        border-left-color: var(--accent);
        font-weight: 700;
    }

    .menu-group {
        margin-top: var(--spacing-sm);
    }

    .menu-group-title {
        font-size: 1.125rem;
        letter-spacing: 2px;
        color: var(--text-muted);
        padding: 8px 20px;
        display: block;
        font-weight: 700;
        border-left: 3px solid transparent;
        transition: all var(--transition);
        width: 100%;
        text-align: left;
        background: none;
        border: none;
        border-bottom: 1px solid transparent;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .menu-group-title.active {
        color: var(--text-primary);
        border-left-color: var(--accent);
    }

    .menu-group-title:hover {
        color: var(--text-primary);
    }

    .accordion-icon {
        width: 12px;
        height: 12px;
        position: relative;
        transition: transform var(--transition);
        opacity: 0.5;
    }

    .accordion-icon::before,
    .accordion-icon::after {
        content: "";
        position: absolute;
        background: currentColor;
        transition: transform var(--transition);
    }

    /* Horizontal line */
    .accordion-icon::before {
        width: 12px;
        height: 2px;
        top: 5px;
        left: 0;
    }

    /* Vertical line */
    .accordion-icon::after {
        width: 2px;
        height: 12px;
        top: 0;
        left: 5px;
    }

    :global(.menu-group.active) .accordion-icon {
        transform: rotate(45deg);
    }

    :global(.menu-group.active) .accordion-icon::after {
        /* This effectively makes the plus a minus or just rotates the plus to an x */
        /* transform: rotate(90deg); */
    }

    .accordion-content {
        max-height: 0;
        overflow: hidden;
        transition:
            max-height var(--transition) cubic-bezier(0.4, 0, 0.2, 1),
            opacity var(--transition) ease,
            margin var(--transition) ease;
        opacity: 0;
    }

    :global(.menu-group.active) .accordion-content {
        max-height: 800px;
        opacity: 1;
        margin-top: 5px;
        margin-bottom: var(--spacing-sm);
    }

    /* Reveal animation for items inside */
    .accordion-content .menu-item {
        transform: translateY(-8px);
        opacity: 0;
        transition:
            transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1),
            opacity 0.4s ease;
    }

    :global(.menu-group.active) .accordion-content .menu-item {
        transform: translateY(0);
        opacity: 1;
    }

    /* Staggered delay for smoother feel */
    .accordion-content .menu-item:nth-child(2) {
        transition-delay: 0.05s;
    }
    .accordion-content .menu-item:nth-child(3) {
        transition-delay: 0.1s;
    }
    .accordion-content .menu-item:nth-child(4) {
        transition-delay: 0.15s;
    }
    .accordion-content .menu-item:nth-child(5) {
        transition-delay: 0.2s;
    }

    .menu-link {
        text-decoration: none;
        transition: all var(--transition);
        cursor: pointer;
    }

    .menu-link:hover {
        color: var(--text-primary);
    }

    .menu-subitem {
        font-size: 1.125rem;
        padding-left: 30px;
    }

    /* Responsive adjustments */
    @media (min-width: 768px) {
        .menu-item {
            font-size: 1.25rem;
        }

        .menu-subitem {
            font-size: 1.125rem;
        }
    }
</style>
