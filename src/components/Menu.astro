---
interface Props {
    currentPage?: string;
}

const { currentPage } = Astro.props;

import { getCollection } from "astro:content";
import { discoverExercises } from "../utils/discoverExercises";

interface MenuItem {
    slug: string;
    label: string;
    order: number;
}

interface MenuGroup {
    title: string;
    items: MenuItem[];
}

interface MenuSection {
    title: string;
    items?: MenuItem[];
    groups?: MenuGroup[];
}

const GROUP_ORDER = [
    "Aritmética",
    "Álgebra",
    "Funciones y Límites",
    "Potencias, raíces y logaritmos",
    "Estadística y Probabilidad",
];

const topics = await getCollection("topics");
const topicsByGroup = new Map<string, MenuItem[]>();

for (const entry of topics) {
    const groupName = entry.data.menuGroup || "General";
    if (!topicsByGroup.has(groupName)) {
        topicsByGroup.set(groupName, []);
    }
    topicsByGroup.get(groupName)!.push({
        slug: `theory/${entry.id}`,
        label: entry.data.title,
        order: entry.data.menuOrder ?? 999,
    });
}

for (const items of topicsByGroup.values()) {
    items.sort((a, b) =>
        a.order !== b.order
            ? a.order - b.order
            : a.label.localeCompare(b.label, "es"),
    );
}

const theoryGroups: MenuGroup[] = [];
for (const gName of GROUP_ORDER) {
    if (topicsByGroup.has(gName)) {
        theoryGroups.push({
            title: gName,
            items: topicsByGroup.get(gName)!,
        });
        topicsByGroup.delete(gName);
    }
}
for (const [gName, items] of topicsByGroup.entries()) {
    theoryGroups.push({
        title: gName,
        items,
    });
}

const exercisesData = discoverExercises();
const exerciseItems: MenuItem[] = Object.entries(exercisesData).map(
    ([key, data], idx) => ({
        slug: `exercises/${key}`,
        label: data.title,
        order: idx,
    }),
);

const menuSections: MenuSection[] = [
    {
        title: "Teoría",
        groups: theoryGroups,
    },
    {
        title: "Ejercicios",
        items: exerciseItems,
    },
];

const isGroupActive = (items: { slug: string }[]) =>
    items.some((item) => item.slug === currentPage);

const isSectionActive = (section: MenuSection) => {
    if (section.groups && section.groups.length > 0) {
        return section.groups.some((group) => isGroupActive(group.items));
    }
    if (section.items && section.items.length > 0) {
        return isGroupActive(section.items);
    }
    return false;
};
---

<!-- Menu Overlay -->
<div class="menu-overlay" id="menuOverlay">
    <div class="menu-accordion-inner">
        <nav class="menu-nav">
            <!-- Main links -->
            <div class="menu-group">
                <a
                    href="/"
                    data-astro-prefetch="hover"
                    data-close-menu
                    class:list={[
                        "menu-group-title",
                        "menu-link",
                        "nav-home",
                        { active: currentPage === "index" },
                    ]}
                >
                    Inicio
                </a>
                <a
                    href="/#contacto"
                    data-astro-prefetch="hover"
                    data-close-menu
                    class:list={["menu-item", "menu-subitem", "nav-contacto"]}
                >
                    Contacto
                </a>
            </div>

            <!-- Dynamic Category Accordions -->
            {
                menuSections.map((section) => (
                    <div
                        class:list={[
                            "menu-group accordion",
                            { active: isSectionActive(section) },
                        ]}
                        data-accordion
                    >
                        <button class="menu-group-title accordion-trigger">
                            {section.title}
                            <span class="accordion-icon" />
                        </button>
                        <div class="accordion-content">
                            <div class="accordion-inner">
                                {section.items &&
                                    section.items.map((item) => (
                                        <div class="menu-group nested">
                                            <a
                                                href={`/${item.slug}`}
                                                data-astro-prefetch="hover"
                                                data-close-menu
                                                class:list={[
                                                    "menu-group-title",
                                                    "menu-link",
                                                    {
                                                        active:
                                                            currentPage ===
                                                            item.slug,
                                                    },
                                                ]}
                                                aria-current={
                                                    currentPage === item.slug
                                                        ? "page"
                                                        : undefined
                                                }
                                            >
                                                {item.label}
                                            </a>
                                        </div>
                                    ))}
                                {section.groups &&
                                    section.groups.map((group) => (
                                        <div
                                            class:list={[
                                                "menu-group accordion nested",
                                                {
                                                    active: isGroupActive(
                                                        group.items,
                                                    ),
                                                },
                                            ]}
                                            data-accordion
                                        >
                                            <button class="menu-group-title accordion-trigger">
                                                {group.title}
                                                <span class="accordion-icon" />
                                            </button>
                                            <div class="accordion-content">
                                                <div class="accordion-inner">
                                                    {group.items.map((item) => (
                                                        <a
                                                            href={`/${item.slug}`}
                                                            data-astro-prefetch="hover"
                                                            data-close-menu
                                                            class:list={[
                                                                "menu-item",
                                                                "menu-subitem",
                                                                {
                                                                    active:
                                                                        currentPage ===
                                                                        item.slug,
                                                                },
                                                            ]}
                                                            aria-current={
                                                                currentPage ===
                                                                item.slug
                                                                    ? "page"
                                                                    : undefined
                                                            }
                                                        >
                                                            {item.label}
                                                        </a>
                                                    ))}
                                                </div>
                                            </div>
                                        </div>
                                    ))}
                            </div>
                        </div>
                    </div>
                ))
            }
        </nav>
    </div>
</div>

<script>
    import "../scripts/menu.js";
</script>

<style>
    /* ===== MENU OVERLAY ===== */
    .menu-overlay {
        position: fixed;
        top: 48px;
        left: 0;
        right: 0;
        background: var(--bg-primary);
        z-index: 1000;
        display: grid;
        grid-template-rows: 0fr;
        opacity: 0;
        pointer-events: none;
        transition:
            grid-template-rows 0.5s cubic-bezier(0.4, 0, 0.2, 1),
            opacity 0.4s ease;
        max-height: calc(100dvh - 48px);
        overflow-y: auto;
        overscroll-behavior: contain;
        -webkit-overflow-scrolling: touch;
    }

    .menu-overlay.active {
        grid-template-rows: 1fr;
        opacity: 1;
        pointer-events: all;
    }

    .menu-accordion-inner {
        min-height: 0;
        display: flex;
        justify-content: center;
    }

    .menu-nav {
        display: flex;
        flex-direction: column;
        gap: 5px;
        padding: var(--spacing-lg);
        padding-bottom: calc(30px + env(safe-area-inset-bottom));
        max-width: 500px;
        width: 100%;
    }

    .menu-item {
        font-size: 1.125rem;
        color: var(--text-muted);
        text-decoration: none;
        padding: 12px 20px;
        border-left: 3px solid transparent;
        transition: all var(--transition);
        display: block;
        line-height: 1.4;
    }

    .menu-item:hover {
        color: var(--text-primary);
        border-left-color: var(--border-color);
    }

    .menu-item.active {
        color: var(--text-primary);
        border-left-color: var(--accent);
        font-weight: 700;
    }

    .menu-group {
        margin-top: var(--spacing-sm);
    }

    .menu-group-title {
        font-size: 1.125rem;
        letter-spacing: 2px;
        color: var(--text-muted);
        padding: 8px 20px;
        font-weight: 700;
        transition: all var(--transition);
        width: 100%;
        text-align: left;
        background: none;
        border: none;
        border-left: 3px solid transparent;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .menu-group-title.active {
        color: var(--text-primary);
        border-left-color: var(--accent);
    }

    .menu-group-title:hover {
        color: var(--text-primary);
    }

    .accordion-icon {
        width: 12px;
        height: 12px;
        position: relative;
        transition: transform var(--transition);
        opacity: 0.5;
    }

    .accordion-icon::before,
    .accordion-icon::after {
        content: "";
        position: absolute;
        background: currentColor;
        transition: transform var(--transition);
    }

    .accordion-icon::before {
        width: 12px;
        height: 2px;
        top: 5px;
        left: 0;
    }

    .accordion-icon::after {
        width: 2px;
        height: 12px;
        top: 0;
        left: 5px;
    }

    .menu-group.active > .menu-group-title .accordion-icon {
        transform: rotate(45deg);
    }

    .accordion-content {
        display: grid;
        grid-template-rows: 0fr;
        transition:
            grid-template-rows 0.4s cubic-bezier(0.4, 0, 0.2, 1),
            opacity 0.4s ease,
            margin 0.4s ease;
        opacity: 0;
        overflow: hidden;
    }

    .menu-group.active > .accordion-content {
        grid-template-rows: 1fr;
        opacity: 1;
        margin-top: 5px;
        margin-bottom: var(--spacing-sm);
    }

    .accordion-inner {
        min-height: 0;
    }

    .menu-link {
        text-decoration: none;
        transition: all var(--transition);
        cursor: pointer;
    }

    .menu-link:hover {
        color: var(--text-primary);
    }

    .menu-subitem {
        font-size: 1.125rem;
        padding-left: 30px;
    }

    @media (min-width: 768px) {
        .menu-item {
            font-size: 1.25rem;
        }

        .menu-subitem {
            font-size: 1.125rem;
        }
    }

    .menu-group.nested {
        margin-top: 5px;
    }

    .menu-group.nested .menu-group-title {
        font-size: 1rem;
        opacity: 0.9;
        font-weight: 600;
        padding: 6px 20px 6px 35px;
    }

    .menu-group.nested .menu-item {
        font-size: 1rem;
        padding: 8px 15px;
    }

    .menu-group.nested .menu-subitem {
        padding-left: 50px;
    }
</style>
