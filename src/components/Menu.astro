---
interface Props {
    currentPage?: string;
}

const { currentPage } = Astro.props;
---

<!-- Menu Overlay -->
<div class="menu-overlay" id="menuOverlay">
    <nav class="menu-nav">
        <div class="menu-group">
            <a
                href="/"
                data-astro-prefetch
                data-close-menu
                class:list={[
                    "menu-group-title",
                    "menu-link",
                    "nav-home",
                    { active: currentPage === "index" },
                ]}
            >
                Inicio
            </a>
            <a
                href="/#contacto"
                data-astro-prefetch
                data-close-menu
                class:list={["menu-item", "menu-subitem", "nav-contacto"]}
            >
                Contacto
            </a>
        </div>

        <div class="menu-group">
            <span class="menu-group-title">Aritmética</span>
            <a
                href="/jerarquia"
                data-astro-prefetch
                class:list={[
                    "menu-item",
                    "menu-subitem",
                    { active: currentPage === "jerarquia" },
                ]}
                aria-current={currentPage === "jerarquia" ? "page" : undefined}
            >
                Jerarquía de las operaciones
            </a>
            <a
                href="/propiedades-operaciones"
                data-astro-prefetch
                class:list={[
                    "menu-item",
                    "menu-subitem",
                    { active: currentPage === "propiedades-operaciones" },
                ]}
                aria-current={currentPage === "propiedades-operaciones"
                    ? "page"
                    : undefined}
            >
                Propiedades de las operaciones
            </a>
            <a
                href="/divisibilidad"
                data-astro-prefetch
                class:list={[
                    "menu-item",
                    "menu-subitem",
                    { active: currentPage === "divisibilidad" },
                ]}
                aria-current={currentPage === "divisibilidad"
                    ? "page"
                    : undefined}
            >
                Factorización de números
            </a>
            <a
                href="/fracciones"
                data-astro-prefetch
                class:list={[
                    "menu-item",
                    "menu-subitem",
                    { active: currentPage === "fracciones" },
                ]}
                aria-current={currentPage === "fracciones" ? "page" : undefined}
            >
                Operaciones con fracciones
            </a>
        </div>

        <div class="menu-group">
            <span class="menu-group-title">Álgebra</span>
            <a
                href="/identidades-notables"
                data-astro-prefetch
                class:list={[
                    "menu-item",
                    "menu-subitem",
                    { active: currentPage === "identidades-notables" },
                ]}
                aria-current={currentPage === "identidades-notables"
                    ? "page"
                    : undefined}
            >
                Identidades notables
            </a>
        </div>

        <div class="menu-group">
            <span class="menu-group-title">Potencias y logaritmos</span>
            <a
                href="/potencias"
                data-astro-prefetch
                class:list={[
                    "menu-item",
                    "menu-subitem",
                    { active: currentPage === "potencias" },
                ]}
                aria-current={currentPage === "potencias" ? "page" : undefined}
            >
                Propiedades de las potencias
            </a>
            <a
                href="/raices"
                data-astro-prefetch
                class:list={[
                    "menu-item",
                    "menu-subitem",
                    { active: currentPage === "raices" },
                ]}
                aria-current={currentPage === "raices" ? "page" : undefined}
            >
                Propiedades de las raíces
            </a>
            <a
                href="/logaritmos"
                data-astro-prefetch
                class:list={[
                    "menu-item",
                    "menu-subitem",
                    { active: currentPage === "logaritmos" },
                ]}
                aria-current={currentPage === "logaritmos" ? "page" : undefined}
            >
                Propiedades de los logaritmos
            </a>
        </div>
    </nav>
</div>

<script>
    import "../scripts/menu.js";
</script>

<style>
    /* ===== MENU OVERLAY ===== */
    .menu-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        width: 100%;
        /* Use dvh for dynamic viewport height support in modern Safari */
        height: 100vh;
        height: 100dvh;
        background: var(--bg-primary);
        z-index: 1000;
        display: flex;
        align-items: flex-start;
        justify-content: center;
        opacity: 0;
        pointer-events: none;
        transition: opacity var(--transition);
        padding-top: 40px;
        overflow-y: auto;
        overscroll-behavior: contain;
        -webkit-overflow-scrolling: touch;
    }

    @media (min-width: 768px) {
        .menu-overlay {
            padding-top: 80px;
        }
    }

    :global(.menu-overlay.active) {
        opacity: 1;
        pointer-events: all;
    }

    .menu-nav {
        display: flex;
        flex-direction: column;
        gap: 5px;
        padding: var(--spacing-lg);
        padding-bottom: calc(30px + env(safe-area-inset-bottom));
        max-width: 500px;
        width: 100%;
    }

    .menu-item {
        font-size: 1.125rem;
        color: var(--text-muted);
        text-decoration: none;
        padding: 12px 20px;
        border-left: 3px solid transparent;
        transition: all var(--transition);
        display: block;
        white-space: normal;
        line-height: 1.4;
    }

    .menu-item:hover {
        color: var(--text-primary);
        border-left-color: var(--border-color);
    }

    .menu-item.active {
        color: var(--text-primary);
        border-left-color: var(--accent);
        font-weight: 700;
    }

    .menu-group {
        margin-top: var(--spacing-sm);
    }

    .menu-group-title {
        font-size: 1.125rem;
        letter-spacing: 2px;
        color: var(--text-muted);
        padding: 8px 20px;
        display: block;
        font-weight: 700;
        border-left: 3px solid transparent;
        transition: all var(--transition);
    }

    .menu-group-title.active {
        color: var(--text-primary);
        border-left-color: var(--accent);
    }

    .menu-link {
        text-decoration: none;
        transition: all var(--transition);
        cursor: pointer;
    }

    .menu-link:hover {
        color: var(--text-primary);
    }

    .menu-subitem {
        font-size: 1.125rem;
        padding-left: 30px;
    }

    /* Responsive adjustments */
    @media (min-width: 768px) {
        .menu-item {
            font-size: 1.25rem;
        }

        .menu-subitem {
            font-size: 1.125rem;
        }
    }
</style>
