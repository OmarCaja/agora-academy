---
interface Props {
    currentPage?: string;
}

const { currentPage } = Astro.props;

// Menu configuration for easier maintenance
const menuGroups = [
    {
        title: "Aritmética",
        items: [
            { slug: "jerarquia", label: "Jerarquía de las operaciones" },
            {
                slug: "propiedades-operaciones",
                label: "Propiedades de las operaciones",
            },
            { slug: "divisibilidad", label: "Factorización de números" },
            { slug: "fracciones", label: "Operaciones con fracciones" },
        ],
    },
    {
        title: "Álgebra",
        items: [
            { slug: "identidades-notables", label: "Identidades notables" },
        ],
    },
    {
        title: "Potencias y logaritmos",
        items: [
            { slug: "potencias", label: "Propiedades de las potencias" },
            { slug: "raices", label: "Propiedades de las raíces" },
            { slug: "logaritmos", label: "Propiedades de los logaritmos" },
        ],
    },
];

// Helper to determine if a group should be open (active)
const isGroupActive = (items: { slug: string }[]) =>
    items.some((item) => item.slug === currentPage);
---

<!-- Menu Overlay -->
<div class="menu-overlay" id="menuOverlay">
    <nav class="menu-nav">
        <!-- Main links -->
        <div class="menu-group">
            <a
                href="/"
                data-astro-prefetch
                data-close-menu
                class:list={[
                    "menu-group-title",
                    "menu-link",
                    "nav-home",
                    { active: currentPage === "index" },
                ]}
            >
                Inicio
            </a>
            <a
                href="/#contacto"
                data-astro-prefetch
                data-close-menu
                class:list={["menu-item", "menu-subitem", "nav-contacto"]}
            >
                Contacto
            </a>
        </div>

        <!-- Dynamic Category Accordions -->
        {
            menuGroups.map((group) => (
                <div
                    class:list={[
                        "menu-group accordion",
                        { active: isGroupActive(group.items) },
                    ]}
                    data-accordion
                >
                    <button class="menu-group-title accordion-trigger">
                        {group.title}
                        <span class="accordion-icon" />
                    </button>
                    <div class="accordion-content">
                        <div class="accordion-inner">
                            {group.items.map((item) => (
                                <a
                                    href={`/${item.slug}`}
                                    data-astro-prefetch
                                    class:list={[
                                        "menu-item",
                                        "menu-subitem",
                                        { active: currentPage === item.slug },
                                    ]}
                                    aria-current={
                                        currentPage === item.slug
                                            ? "page"
                                            : undefined
                                    }
                                >
                                    {item.label}
                                </a>
                            ))}
                        </div>
                    </div>
                </div>
            ))
        }
    </nav>
</div>

<script>
    import "../scripts/menu.js";
</script>

<style>
    /* ===== MENU OVERLAY ===== */
    .menu-overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        width: 100%;
        /* Use dvh for dynamic viewport height support in modern Safari */
        height: 100vh;
        height: 100dvh;
        background: var(--bg-primary);
        z-index: 1000;
        display: flex;
        align-items: flex-start;
        justify-content: center;
        opacity: 0;
        pointer-events: none;
        transition: opacity var(--transition);
        padding-top: 40px;
        overflow-y: auto;
        overscroll-behavior: contain;
        -webkit-overflow-scrolling: touch;
    }

    @media (min-width: 768px) {
        .menu-overlay {
            padding-top: 80px;
        }
    }

    :global(.menu-overlay.active) {
        opacity: 1;
        pointer-events: all;
    }

    .menu-nav {
        display: flex;
        flex-direction: column;
        gap: 5px;
        padding: var(--spacing-lg);
        padding-bottom: calc(30px + env(safe-area-inset-bottom));
        max-width: 500px;
        width: 100%;
    }

    .menu-item {
        font-size: 1.125rem;
        color: var(--text-muted);
        text-decoration: none;
        padding: 12px 20px;
        border-left: 3px solid transparent;
        transition: all var(--transition);
        display: block;
        white-space: normal;
        line-height: 1.4;
    }

    .menu-item:hover {
        color: var(--text-primary);
        border-left-color: var(--border-color);
    }

    .menu-item.active {
        color: var(--text-primary);
        border-left-color: var(--accent);
        font-weight: 700;
    }

    .menu-group {
        margin-top: var(--spacing-sm);
    }

    .menu-group-title {
        font-size: 1.125rem;
        letter-spacing: 2px;
        color: var(--text-muted);
        padding: 8px 20px;
        display: block;
        font-weight: 700;
        border-left: 3px solid transparent;
        transition: all var(--transition);
        width: 100%;
        text-align: left;
        background: none;
        border: none;
        border-bottom: 1px solid transparent;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .menu-group-title.active {
        color: var(--text-primary);
        border-left-color: var(--accent);
    }

    .menu-group-title:hover {
        color: var(--text-primary);
    }

    .accordion-icon {
        width: 12px;
        height: 12px;
        position: relative;
        transition: transform var(--transition);
        opacity: 0.5;
    }

    .accordion-icon::before,
    .accordion-icon::after {
        content: "";
        position: absolute;
        background: currentColor;
        transition: transform var(--transition);
    }

    /* Horizontal line */
    .accordion-icon::before {
        width: 12px;
        height: 2px;
        top: 5px;
        left: 0;
    }

    /* Vertical line */
    .accordion-icon::after {
        width: 2px;
        height: 12px;
        top: 0;
        left: 5px;
    }

    :global(.menu-group.active) .accordion-icon {
        transform: rotate(45deg);
    }

    :global(.menu-group.active) .accordion-icon::after {
        /* This effectively makes the plus a minus or just rotates the plus to an x */
        /* transform: rotate(90deg); */
    }

    .accordion-content {
        display: grid;
        grid-template-rows: 0fr;
        transition:
            grid-template-rows 0.4s cubic-bezier(0.4, 0, 0.2, 1),
            opacity 0.4s ease,
            margin 0.4s ease;
        opacity: 0;
        overflow: hidden;
    }

    :global(.menu-group.active) .accordion-content {
        grid-template-rows: 1fr;
        opacity: 1;
        margin-top: 5px;
        margin-bottom: var(--spacing-sm);
    }

    .accordion-inner {
        min-height: 0; /* Crucial for grid rows transition */
    }

    /* Reveal animation for items inside */
    .accordion-content .menu-item {
        transform: translateY(-10px);
        opacity: 0;
        transition:
            transform 0.5s cubic-bezier(0.4, 0, 0.2, 1),
            opacity 0.4s ease;
    }

    :global(.menu-group.active) .accordion-content .menu-item {
        transform: translateY(0);
        opacity: 1;
        transition:
            transform 0.5s cubic-bezier(0.2, 0.8, 0.2, 1.1),
            opacity 0.4s ease;
    }

    /* Staggered DELAYS */
    /* ENTRANCE (top to bottom) */
    :global(.menu-group.active) .accordion-content .menu-item:nth-child(1) {
        transition-delay: 0.05s;
    }
    :global(.menu-group.active) .accordion-content .menu-item:nth-child(2) {
        transition-delay: 0.1s;
    }
    :global(.menu-group.active) .accordion-content .menu-item:nth-child(3) {
        transition-delay: 0.15s;
    }
    :global(.menu-group.active) .accordion-content .menu-item:nth-child(4) {
        transition-delay: 0.2s;
    }
    :global(.menu-group.active) .accordion-content .menu-item:nth-child(5) {
        transition-delay: 0.25s;
    }

    /* EXIT (bottom up) - Using nth-last-child ensures the LAST item always starts at 0s */
    .accordion-content .menu-item:nth-last-child(1) {
        transition-delay: 0s;
    }
    .accordion-content .menu-item:nth-last-child(2) {
        transition-delay: 0.03s;
    }
    .accordion-content .menu-item:nth-last-child(3) {
        transition-delay: 0.06s;
    }
    .accordion-content .menu-item:nth-last-child(4) {
        transition-delay: 0.09s;
    }
    .accordion-content .menu-item:nth-last-child(5) {
        transition-delay: 0.12s;
    }

    .menu-link {
        text-decoration: none;
        transition: all var(--transition);
        cursor: pointer;
    }

    .menu-link:hover {
        color: var(--text-primary);
    }

    .menu-subitem {
        font-size: 1.125rem;
        padding-left: 30px;
    }

    /* Responsive adjustments */
    @media (min-width: 768px) {
        .menu-item {
            font-size: 1.25rem;
        }

        .menu-subitem {
            font-size: 1.125rem;
        }
    }
</style>
