---
import { Icon } from "astro-icon/components";
import { SITE_URL } from "../data/site";

interface BreadcrumbItem {
    label: string;
    href?: string;
}

interface Props {
    items: BreadcrumbItem[];
}

const { items } = Astro.props;

// Phones show only this one: the nearest ancestor that is a page.
const parentIndex = items.slice(0, -1).findLastIndex((item) => item.href);

const schema = {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    // Google requires "item" on every non-final ListItem: drop labels without a page, link the last to the current URL.
    itemListElement: items
        .map((item, idx) => ({ ...item, href: idx === items.length - 1 ? Astro.url.pathname : item.href }))
        .filter((item) => item.href)
        .map((item, index) => ({
            "@type": "ListItem",
            position: index + 1,
            name: item.label,
            item: `${SITE_URL}${item.href}`,
        })),
};
---

<nav aria-label="Miga de pan" class="breadcrumbs-container">
    <ol class="breadcrumbs-list">
        {
            items.map((item, idx) => {
                const isLast = idx === items.length - 1;
                return (
                    <li class:list={["breadcrumb-item", { "is-parent": idx === parentIndex }]}>
                        {item.href && !isLast ? (
                            <a href={item.href} class="breadcrumb-link">
                                {idx === parentIndex && (
                                    <Icon name="ph:arrow-left" class="breadcrumb-back" aria-hidden="true" />
                                )}
                                {item.label}
                            </a>
                        ) : (
                            <span class="breadcrumb-current" aria-current={isLast ? "page" : undefined}>
                                {item.label}
                            </span>
                        )}
                        {!isLast && <span class="breadcrumb-separator" aria-hidden="true">/</span>}
                    </li>
                );
            })
        }
    </ol>
</nav>

<script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />

<style>
    .breadcrumbs-container {
        margin-bottom: 0;
    }

    .breadcrumbs-list {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        list-style: none;
        padding: 0;
        margin: 0;
        gap: 6px;
        font-size: var(--font-size-sm);
    }

    .breadcrumb-item {
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .breadcrumb-link {
        /* 44px touch target without adding visual weight. */
        display: inline-flex;
        align-items: center;
        gap: 6px;
        min-height: 44px;
        color: var(--text-muted);
        text-decoration: none;
        transition: color var(--transition);
    }

    .breadcrumb-link :global(.breadcrumb-back) {
        display: none;
        width: 16px;
        height: 16px;
    }

    /* Phones: the full trail wraps to three lines above the title. One link
       back to the parent page does the same job in one. */
    @media (max-width: 599px) {
        .breadcrumb-item:not(.is-parent),
        .breadcrumb-separator {
            display: none;
        }

        .breadcrumb-link {
            font-weight: 700;
        }

        .breadcrumb-link :global(.breadcrumb-back) {
            display: block;
        }
    }

    .breadcrumb-link:hover {
        color: var(--text-primary);
        text-decoration: underline;
    }

    .breadcrumb-separator {
        color: var(--text-muted);
        opacity: 0.6;
        user-select: none;
    }

    .breadcrumb-current {
        color: var(--text-primary);
        font-weight: 700;
    }

    @media print {
        .breadcrumbs-container {
            display: none !important;
        }
    }
</style>
