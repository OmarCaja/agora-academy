<!-- KaTeX for math rendering -->
<link
    rel="stylesheet"
    href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css"
/>
<script
    is:inline
    src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js"></script>
<script
    is:inline
    src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/auto-render.min.js"
></script>

<script is:inline>
    (function () {
        /**
         * Initialize KaTeX rendering
         */
        const initKatex = function () {
            if (typeof renderMathInElement === "function" && document.body) {
                renderMathInElement(document.body, {
                    delimiters: [
                        { left: "$$", right: "$$", display: true },
                        { left: "$", right: "$", display: false },
                        { left: "\\(", right: "\\)", display: false },
                        { left: "\\[", right: "\\]", display: true },
                    ],
                    throwOnError: false,
                });
            }
        };

        // Persistent check to ensure rendering happens as soon as possible
        let renderInterval = setInterval(() => {
            if (typeof renderMathInElement === "function" && document.body) {
                initKatex();
                clearInterval(renderInterval);
            }
        }, 50);

        // Stop checking after 3 seconds to avoid battery drain if something fails
        setTimeout(() => clearInterval(renderInterval), 3000);

        // Standard Astro lifecycle listeners (only add once)
        if (!window.katexListenersAdded) {
            document.addEventListener("astro:page-load", initKatex);
            document.addEventListener("astro:after-swap", initKatex);
            window.katexListenersAdded = true;
        }

        // Global exposure for debugging or manual triggers
        window.initKatex = initKatex;
    })();
</script>
