---
const year = new Date().getFullYear();
---

<footer class="site-footer">
    <div class="footer-content">
        <div class="footer-brand">
            <span class="footer-logo">ÁGORA</span>
            <p class="footer-tagline">Academia de matemáticas en Cuenca</p>
        </div>

        <nav class="footer-links" aria-label="Navegación pie de página">
            <a href="/">Inicio</a>
            <a href="/theory/algebra">Teoría</a>
            <a href="/exercises/1-eso">Ejercicios</a>
            <a href="/#contacto">Contacto</a>
        </nav>
    </div>

    <div class="footer-bottom">
        <p>© {year} Ágora Academy. Todos los derechos reservados.</p>
    </div>
</footer>

<style>
    .site-footer {
        margin-top: var(--spacing-xl);
        padding-top: var(--spacing-lg);
        padding-bottom: var(--spacing-lg);
        border-top: var(--border-width) solid var(--border-color);
        display: flex;
        flex-direction: column;
        gap: var(--spacing-md);
    }

    .footer-content {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-md);
        justify-content: space-between;
        align-items: flex-start;
    }

    .footer-brand {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .footer-logo {
        font-weight: 700;
        font-size: 1.25rem;
        letter-spacing: 2px;
        color: var(--text-primary);
    }

    .footer-tagline {
        font-size: 0.95rem;
        color: var(--text-muted);
        margin: 0;
    }

    .footer-links {
        display: flex;
        flex-wrap: wrap;
        gap: var(--spacing-md);
    }

    .footer-links a {
        color: var(--text-secondary);
        text-decoration: none;
        font-size: 0.95rem;
        font-weight: 500;
        transition: color var(--transition);
    }

    .footer-links a:hover {
        color: var(--text-primary);
        text-decoration: underline;
    }

    .footer-bottom {
        font-size: 0.85rem;
        color: var(--text-muted);
        border-top: 1px dashed var(--border-color);
        padding-top: var(--spacing-sm);
        margin-top: var(--spacing-xs);
    }

    .footer-bottom p {
        margin: 0;
    }

    @media (min-width: 768px) {
        .footer-content {
            flex-direction: row;
            align-items: center;
        }
    }
</style>
