---
import { Icon } from "astro-icon/components";
import { SITE_NAME, SHORT_NAME, ADDRESS, INSTAGRAM_URL } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="site-footer">
    <div class="footer-content reveal">
        <div class="footer-brand">
            <span class="footer-logo">{SHORT_NAME.toUpperCase()}</span>
            <p class="footer-tagline">Academia de matemáticas en {ADDRESS.city}</p>
        </div>

        <nav class="footer-links" aria-label="Navegación pie de página">
            <a href="/">Inicio</a>
            <a href="/theory/">Teoría</a>
            <a href="/exercises/">Ejercicios</a>
            <a href="/books/">Libros PDF</a>
            <a href="/#contacto">Contacto</a>
            <a
                href={INSTAGRAM_URL}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`Instagram de ${SITE_NAME}`}
                class="footer-social"
            >
                <Icon name="ph:instagram-logo" aria-hidden="true" />
            </a>
        </nav>
    </div>

    <div class="footer-bottom reveal" style="--i: 1">
        <p>© {year} {SITE_NAME}. Todos los derechos reservados.</p>
        <p class="footer-credit">
            Desarrollado con
            <Icon name="ph:heart-fill" aria-label="amor" class="footer-heart" />
            por
            <a href="https://kaizencode.es" target="_blank" rel="noopener noreferrer">
                Kaizencode
                <Icon name="ph:arrow-square-out" aria-hidden="true" />
            </a>
        </p>
    </div>
</footer>

<style>
    .site-footer {
        margin-top: var(--spacing-xl);
        padding-top: var(--spacing-lg);
        padding-bottom: var(--spacing-lg);
        border-top: var(--border-width) solid var(--border-color);
        display: flex;
        flex-direction: column;
        gap: var(--spacing-md);
    }

    .footer-content {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-md);
        justify-content: space-between;
        align-items: flex-start;
    }

    .footer-brand {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .footer-logo {
        font-weight: 700;
        font-size: 1.3rem;
        letter-spacing: 3px;
        color: var(--text-primary);
        align-self: flex-start;
    }

    .footer-tagline {
        font-size: var(--font-size-md);
        color: var(--text-muted);
        margin: 0;
    }

    .footer-links {
        display: flex;
        flex-wrap: wrap;
        gap: var(--spacing-md);
    }

    .footer-links a {
        color: var(--text-secondary);
        text-decoration: none;
        font-size: var(--font-size-md);
        font-weight: 700;
        padding-bottom: 2px;
        border-bottom: 2px solid transparent;
        transition: color var(--transition), border-color var(--transition);
    }

    .footer-links a:hover {
        border-bottom-color: var(--accent);
    }

    .footer-links a:hover {
        color: var(--accent-strong);
    }

    .footer-social {
        display: inline-flex;
        align-items: center;
        border-bottom: none !important;
    }

    .footer-social svg {
        width: 1.3rem;
        height: 1.3rem;
    }

    .footer-bottom {
        font-size: 0.78rem;
        color: var(--text-muted);
        border-top: 1px solid var(--rule-color);
        padding-top: var(--spacing-sm);
        margin-top: var(--spacing-xs);
        display: flex;
        flex-wrap: wrap;
        justify-content: space-between;
        gap: var(--spacing-xs);
    }

    .footer-bottom p {
        margin: 0;
    }

    .footer-credit {
        display: inline-flex;
        align-items: center;
        gap: 1ch;
    }

    .footer-credit svg {
        width: 1em;
        height: 1em;
    }

    .footer-heart {
        color: #d46a6a;
    }

    .footer-credit a {
        display: inline-flex;
        align-items: center;
        gap: 0.15em;
        color: var(--text-primary);
        font-weight: 700;
        text-decoration: none;
        transition: color var(--transition);
    }

    .footer-credit a:hover {
        color: var(--accent-strong);
    }

    @media (min-width: 768px) {
        .footer-content {
            flex-direction: row;
            align-items: center;
        }
    }
</style>
